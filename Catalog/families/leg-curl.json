{
  "id": "leg-curl",
  "name": "Leg curl",
  "kind": "strength",
  "bodyModel": "anatomy",
  "tracking": "weight_reps",
  "pattern": "Knee flexion: the heel is pulled toward the buttocks against a load while the hip stays still.",
  "muscles": {
    "primary": [
      "hamstrings"
    ],
    "secondary": [
      "calves"
    ]
  },
  "equipment": [
    "machine",
    "cable-stack",
    "band",
    "dumbbell",
    "stability-ball",
    "towel-chair",
    "suspension"
  ],
  "setup": [
    "Lying machine: knees just off the pad edge, knee joint in line with the machine pivot.",
    "Ankle pad just above the heel, not on the calf.",
    "Hold the handles and press your hips into the pad."
  ],
  "steps": [
    {
      "phase": "Curl",
      "text": "Pull your heels toward your buttocks."
    },
    {
      "phase": "Top",
      "text": "Bend as far as you can without lifting your hips."
    },
    {
      "phase": "Squeeze",
      "text": "Pause for a moment."
    },
    {
      "phase": "Lower",
      "text": "Straighten the knees slowly, all the way, without letting the weight touch down."
    }
  ],
  "cues": [
    {
      "joint": "hips",
      "cue": "Hips pressed into the pad.",
      "why": "Lifting the hips shortens the range and lets the back help.",
      "refs": [
        "schoenfeld2015"
      ]
    },
    {
      "joint": "range",
      "cue": "Full range: nearly straight to fully bent.",
      "why": "The leg curl loads the lower part of the hamstrings more than a hinge does; use all of it.",
      "refs": [
        "schoenfeld2015",
        "stevens2022"
      ]
    },
    {
      "joint": "seated",
      "cue": "Choose seated curls for size when you can.",
      "why": "Seated curls (hips bent, hamstrings longer) grew the hamstrings more than lying curls in 12 weeks.",
      "refs": [
        "maeo2021"
      ]
    },
    {
      "joint": "ankle",
      "cue": "Foot position is up to you.",
      "why": "Toes pointed or pulled up gave the same hamstring activity and gains.",
      "refs": [
        "cadeo2023"
      ]
    },
    {
      "joint": "tempo",
      "cue": "Lower slowly, about 2-3 seconds.",
      "why": "The eccentric phase builds the hamstring strength used in sprinting.",
      "refs": [
        "mcallister2014"
      ]
    }
  ],
  "breathing": "Breathe out as you curl, in as you lower.",
  "tempo": {
    "down": 3,
    "pause": 1,
    "up": 1,
    "note": "Quick curl, slow return."
  },
  "mistakes": [
    {
      "id": "hips",
      "name": "Hips lift off the pad",
      "looks": "The buttocks rise as the heels come up.",
      "fix": "Lighter weight; press the hips down and hold the handles.",
      "why": "The hip bends to finish the rep and the hamstrings do less.",
      "pose": {
        "hipFlex": 25,
        "lumbar": -10
      },
      "detect": {
        "metric": "hipFlex",
        "bad": "> 20"
      },
      "refs": [
        "schoenfeld2015"
      ]
    },
    {
      "id": "short",
      "name": "Half reps",
      "looks": "The knee never straightens or never bends past 90°.",
      "fix": "Lower all the way, curl until the pad nears your buttocks.",
      "why": "Part of the muscle's working range is missed.",
      "pose": {
        "kneeFlex": -40
      },
      "detect": {
        "metric": "kneeFlexRange",
        "bad": "< 90"
      },
      "refs": [
        "maeo2021"
      ]
    },
    {
      "id": "drop",
      "name": "Weight drops on the way down",
      "looks": "The legs fall back down in under a second.",
      "fix": "Count three on the way down.",
      "why": "Skips the eccentric work.",
      "pose": {
        "kneeFlex": -30
      },
      "detect": {
        "metric": "lowerSeconds",
        "bad": "< 1"
      },
      "refs": [
        "mcallister2014"
      ]
    }
  ],
  "safety": [
    "Hamstring cramps: lighter load and stretch between sets.",
    "Knee pain at the back of the knee: shorten the top range."
  ],
  "variants": [
    {
      "when": "seated|sitting",
      "change": "Hips bent about 90°: hamstrings longer, more growth in a 12-week study."
    },
    {
      "when": "standing|kneeling",
      "change": "One leg at a time, hip straight."
    },
    {
      "when": "single|one leg",
      "change": "One leg at a time; even out left and right."
    },
    {
      "when": "ball|stability|slide|sliding|towel|suspension|ring|runner",
      "change": "Lying on your back, hips lifted in a bridge, heels pull the ball or sliders in: hamstrings also hold the hips up."
    },
    {
      "when": "straight hip",
      "change": "Hips kept up and straight the whole time: harder."
    },
    {
      "when": "isometric|hold",
      "change": "Hold a bent-knee position for time."
    },
    {
      "when": "band|resistance band",
      "change": "Band gets harder as the knee bends."
    }
  ],
  "easier": [
    "band leg curl",
    "stability ball leg curl (two legs)"
  ],
  "harder": [
