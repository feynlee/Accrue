{
  "id": "kick",
  "name": "Kicks",
  "kind": "sport",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "pattern": "Strike with the leg from a guard: lift and chamber the knee, extend (or swing) the leg fast toward the target, re-chamber and land back in stance.",
  "muscles": {
    "primary": [
      "hip-flexors",
      "quads",
      "glutes",
      "glute-med"
    ],
    "secondary": [
      "hamstrings",
      "adductors",
      "obliques",
      "abs",
      "calves",
      "heart-lungs"
    ]
  },
  "equipment": [
    "heavy-bag"
  ],
  "setup": [
    "Fighting stance: left foot forward, feet a little wider than your hips, knees soft.",
    "Hands up in a guard, chin tucked.",
    "Warm up hips and hamstrings before high kicks."
  ],
  "steps": [
    {
      "phase": "Stance",
      "text": "Weight balanced, guard up."
    },
    {
      "phase": "Chamber",
      "text": "Lift the kicking knee high and fold the lower leg tight."
    },
    {
      "phase": "Strike",
      "text": "Snap or push the foot out to the target, standing leg slightly bent."
    },
    {
      "phase": "Re-chamber",
      "text": "Pull the foot back to the chamber at once."
    },
    {
      "phase": "Land",
      "text": "Put the foot back down in stance, guard still up."
    }
  ],
  "cues": [
    {
      "joint": "knee",
      "cue": "Chamber high and tight before you extend.",
      "why": "Kicks are proximal-to-distal: the thigh speeds up first, then slows as the shin whips out.",
      "refs": [
        "sorensen1996",
        "estevan2015"
      ]
    },
    {
      "joint": "support foot",
      "cue": "Pivot on the standing foot for round and side kicks.",
      "why": "Turning the support foot lets the hip open and rotate, adding foot speed.",
      "refs": [
        "gavagan2017",
        "kim2011"
      ]
    },
    {
      "joint": "hands",
      "cue": "Keep your guard up while you kick.",
      "why": "Dropping the hands to balance leaves the head open.",
      "refs": [
        "gavagan2017"
      ]
    },
    {
      "joint": "knee",
      "cue": "Re-chamber; never snap the knee to a lock.",
      "why": "Knee extension speed reaches about 700-950°/s; the hamstrings must brake it before full lock.",
      "refs": [
        "gavagan2017",
        "quinzi2013"
      ]
    },
    {
      "joint": "target",
      "cue": "Kick at a height you can control.",
      "why": "Height comes from hip mobility; forcing it costs balance and strains the hamstring.",
      "refs": [
        "estevan2015"
      ]
    }
  ],
  "breathing": "Sharp breath out on each kick.",
  "tempo": {
    "down": 0,
    "pause": 0,
    "up": 0,
    "note": "One kick about 0.5-1 s; train in rounds of 1-3 minutes."
  },
  "mistakes": [
    {
      "id": "no-chamber",
      "name": "No chamber",
      "looks": "The leg swings up straight like a pendulum.",
      "fix": "Knee up first, then extend the shin.",
      "why": "Slower, less accurate kick and more strain on the hamstring.",
      "pose": {
        "kneeFlex": -80
      },
      "detect": {
        "metric": "kneeFlexInChamber",
        "bad": "< 60"
      },
      "refs": [
        "sorensen1996"
      ]
    },
    {
      "id": "lean-back",
      "name": "Leaning far back",
      "looks": "The torso falls back to get the leg up.",
      "fix": "Lower the kick; lean only as much as you need to stay balanced.",
      "why": "Balance and guard are lost and the kick has less force.",
      "pose": {
        "trunk": -30
      },
      "detect": {
        "metric": "trunk",
        "bad": "< -35"
      },
      "refs": [
        "gavagan2017"
      ]
    },
    {
      "id": "no-pivot",
      "name": "Standing foot does not turn",
      "looks": "Support foot stays pointing forward on a roundhouse or side kick.",
      "fix": "Turn the heel toward the target as you kick.",
      "why": "The hip cannot rotate and the knee twists instead.",
      "pose": {
        "hipRotL": -40
      },
      "detect": {
        "metric": "supportPivot",
        "bad": "< 45"
      },
      "refs": [
        "kim2011"
      ]
    },
    {
      "id": "guard-drop",
      "name": "Hands drop",
      "looks": "Arms swing down or out to balance.",
      "fix": "Keep fists at your cheeks.",
      "why": "Head left open; balance gets worse.",
      "pose": {
        "shoulderFlex": -30,
        "shoulderFlexL": -30
      },
      "detect": {
        "metric": "guardHandHeight",
        "bad": "< 0.8"
      },
      "refs": [
        "gavagan2017"
      ]
    }
  ],
  "safety": [
    "Warm up first; build kick height over weeks.",
    "On a bag, kick with the shin or ball of the foot, not the toes.",
    "Knee pain: slow the kick and avoid snapping to full extension."
  ],
  "variants": [
    {
      "when": "bag|partner|pads",
      "change": "Target work; contact changes muscle timing compared with air kicks.",
      "refs": [
        "quinzi2013"
      ]
    },
    {
      "when": "kickboxing-class|kickboxing|class",
      "change": "Kickboxing session: about 7.3 MET (15457).",
      "met": 7.3,
      "metCode": "15457"
    },
    {
      "when": "martial|sparring|combat",
      "change": "Martial arts at a moderate pace: about 10.3 MET (15430); slow novice practice about 5.3 MET (15425).",
      "met": 10.3,
      "metCode": "15430"
    },
    {
      "when": "squat|burpee|push.?up|jump",
      "change": "Kick combined with a squat, jump or push-up; keep the chamber."
    },
    {
      "when": "kneeling|side lying",
      "change": "Floor version: a hip exercise, not a strike."
    },
    {
      "when": "knee kick|knee",
      "change": "Knee strike: drive the knee up and forward, pull the target down."
    }
  ],
