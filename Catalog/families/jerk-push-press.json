{
  "id": "jerk-push-press",
  "name": "Push press, jerk and thruster",
  "kind": "power",
  "bodyModel": "anatomy",
  "tracking": "weight_reps",
  "pattern": "Leg-driven overhead lift: a short knee dip and hard drive launch the weight from the shoulders, the arms finish it overhead.",
  "muscles": {
    "primary": [
      "front-delts",
      "triceps",
      "quads",
      "glutes"
    ],
    "secondary": [
      "side-delts",
      "upper-traps",
      "serratus-anterior",
      "upper-chest",
      "calves",
      "abs",
      "deep-core"
    ]
  },
  "equipment": [
    "barbell",
    "dumbbell",
    "kettlebell"
  ],
  "setup": [
    "Bar on the front of your shoulders, hands just outside them, elbows a little in front of the bar.",
    "Feet hip width, weight over the middle of the foot.",
    "Brace hard: ribs down, glutes tight."
  ],
  "steps": [
    {
      "phase": "Dip",
      "text": "Bend your knees a short way straight down, torso upright, heels flat."
    },
    {
      "phase": "Drive",
      "text": "Drive up hard through your legs so the bar leaves your shoulders."
    },
    {
      "phase": "Press",
      "text": "Push the bar straight up as it rises, moving your head back then through."
    },
    {
      "phase": "Lockout",
      "text": "Arms locked, bar over your ears and mid-foot, legs straight."
    },
    {
      "phase": "Return",
      "text": "Lower the bar to your shoulders, softening your knees to absorb it."
    }
  ],
  "cues": [
    {
      "joint": "trunk",
      "cue": "Dip straight down, chest up.",
      "why": "A forward lean in the dip sends the bar forward instead of up.",
      "refs": [
        "soriano2019",
        "haff2016"
      ]
    },
    {
      "joint": "knees",
      "cue": "Short, fast dip: about a quarter of a squat.",
      "why": "Overhead lifts are driven mostly by the knee; a deep or slow dip loses the stretch and the power.",
      "refs": [
        "cleather2013a",
        "soriano2019"
      ]
    },
    {
      "joint": "legs",
      "cue": "Legs finish the drive before the arms press.",
      "why": "Peak power comes from the leg drive; push press power peaks around 65-75% of a max.",
      "refs": [
        "lake2014b"
      ]
    },
    {
      "joint": "elbows",
      "cue": "Lock out hard, bar over the back of your head.",
      "why": "A stacked lockout puts the load on bones, not on the shoulder muscles.",
      "refs": [
        "haff2016"
      ]
    },
    {
      "joint": "lower back",
      "cue": "Ribs down, glutes tight overhead.",
      "why": "Leaning back to finish the press arches and loads the lower back.",
      "refs": [
        "haff2016"
      ]
    }
  ],
  "breathing": "Breathe in and brace before the dip, hold through the drive, breathe out at lockout or on the way down.",
  "tempo": {
    "down": 2,
    "pause": 0,
    "up": 1,
    "note": "Dip and drive are one quick bounce; lower the bar under control."
  },
  "mistakes": [
    {
      "id": "forward-dip",
      "name": "Dip forward",
      "looks": "Chest drops and hips move back in the dip.",
      "fix": "Knees forward, torso straight up and down.",
      "why": "The bar is driven forward and you chase it.",
      "pose": {
        "trunk": 15,
        "hipFlex": 25
      },
      "detect": {
        "metric": "trunkInDip",
        "bad": "> 10"
      },
      "refs": [
        "soriano2019"
      ]
    },
    {
      "id": "deep-dip",
      "name": "Dip too deep or slow",
      "looks": "Knees bend past a quarter squat and pause at the bottom.",
      "fix": "Short, sharp dip and an instant drive.",
      "why": "It wastes the stretch-shortening response of the legs.",
      "pose": {
        "kneeFlex": 25,
        "hipFlex": 15
      },
      "detect": {
        "metric": "kneeFlexInDip",
        "bad": "> 40"
      },
      "refs": [
        "cleather2013a"
      ]
    },
    {
      "id": "arch",
      "name": "Leaning back to press",
      "looks": "The lower back arches and ribs flare as the bar goes overhead.",
      "fix": "Ribs down, squeeze glutes, lighter weight.",
      "why": "It shifts load to the lower back.",
      "pose": {
        "lumbar": -20,
        "trunk": -10
      },
      "detect": {
        "metric": "lumbar",
        "bad": "< -15"
      },
      "refs": [
        "haff2016"
      ]
    },
    {
      "id": "soft-lockout",
      "name": "Soft lockout",
      "looks": "Elbows still bent when the bar stops overhead.",
      "fix": "Punch up and lock out, then hold for a beat.",
      "why": "Bent elbows overhead load the triceps and shoulder unstably.",
      "pose": {
        "elbowFlex": 25
      },
      "detect": {
        "metric": "elbowFlexOverhead",
        "bad": "> 10"
      },
      "refs": [
        "haff2016"
      ]
    }
  ],
  "safety": [
    "Shoulder pain overhead: use a landmine press or neutral-grip dumbbells.",
    "Wear shoes with a firm sole; a heel lift can help in the thruster squat.",
    "Missed jerk: push the bar forward and step back."
  ],
  "variants": [
    {
      "when": "push press",
      "change": "Legs straight once the drive ends; the arms press to finish."
    },
    {
      "when": "push jerk|power jerk",
      "change": "After the drive, re-bend the knees and drop under the bar to catch it locked in a quarter squat, then stand."
    },
    {
      "when": "split jerk",
      "change": "After the drive, split the feet: front shin vertical, back knee soft on the ball of the foot. Then step the front foot back, then the back foot in."
    },
    {
      "when": "squat jerk",
      "change": "Drop under into a full overhead squat to catch."
    },
    {
      "when": "thruster",
      "change": "Front squat to full depth, then one drive straight into the press."
    },
    {
      "when": "one arm|single arm|alternating",
      "change": "One weight at a time; brace against side bend."
    },
    {
      "when": "landmine",
      "change": "Bar end pressed up and forward on an arc; easier on the shoulder."
    },
    {
      "when": "behind the back|behind",
      "change": "Bar on the back of the shoulders; wider grip."
    },
    {
      "when": "dip squat",
      "change": "Dip drill only: dip and drive, no press."
    }
  ],
