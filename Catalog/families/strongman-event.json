{
  "id": "strongman-event",
  "name": "Strongman events",
  "kind": "strength",
  "bodyModel": "anatomy",
  "tracking": "weight_reps",
  "pattern": "Odd-object lifting and moving: heavy, awkward loads are lifted, flipped, pressed, thrown or pulled with the whole body as one stiff linkage.",
  "muscles": {
    "primary": [
      "glutes",
      "hamstrings",
      "quads",
      "lower-back"
    ],
    "secondary": [
      "upper-traps",
      "mid-traps",
      "lats",
      "biceps",
      "front-delts",
      "triceps",
      "wrist-flexors",
      "abs",
      "obliques",
      "deep-core",
      "glute-med",
      "heart-lungs"
    ]
  },
  "equipment": [
    "strongman",
    "sandbag",
    "strap"
  ],
  "setup": [
    "Learn each event with light implements and a coach before going heavy.",
    "Clear the area, use tacky or chalk as the event allows, and plan where the object goes.",
    "Brace hard before every lift: belly, glutes and grip."
  ],
  "steps": [
    {
      "phase": "Grip",
      "text": "Stone: straddle it, hinge over, hands spread under the sides, arms wrapped round."
    },
    {
      "phase": "Lap",
      "text": "Pull it off the floor and roll it up onto your thighs as you sit back."
    },
    {
      "phase": "Second pull",
      "text": "Re-grip high, hug it to your chest, drop the hips under it."
    },
    {
      "phase": "Over the bar",
      "text": "Drive the hips through hard and extend up and over the bar or onto the platform."
    }
  ],
  "cues": [
    {
      "joint": "hips",
      "cue": "Hips first, then back.",
      "why": "In the stone lift the hip extensors need to fire before the back extensors.",
      "refs": [
        "mcgill2009b"
      ]
    },
    {
      "joint": "trunk",
      "cue": "Brace like a block for carries and the yoke.",
      "why": "Huge trunk co-contraction stiffens the spine and makes up for hip abductor strength in the yoke walk.",
      "refs": [
        "mcgill2009b",
        "hindle2021yoke"
      ]
    },
    {
      "joint": "stone",
      "cue": "Use the lap: the second pull is a front squat with a hug.",
      "why": "The stone lift shares its patterns with the RDL and the front squat; train those.",
      "refs": [
        "hindle2021stone"
      ]
    },
    {
      "joint": "tire",
      "cue": "Tire flip: chest on the tire, push forward and up; arms straight, palms up.",
      "why": "A fast second pull separates fast and slow flips; pulling with bent arms risks the biceps tendon.",
      "refs": [
        "keogh2010tire",
        "lorenz2022"
      ]
    },
    {
      "joint": "log",
      "cue": "Log press: elbows high on the clean, then dip and drive.",
      "why": "A log is harder to drive than a barbell, and a thicker log is harder still.",
      "refs": [
        "renals2018"
      ]
    }
  ],
  "breathing": "Big breath and brace before each lift; on long events breathe at the top or between steps.",
  "tempo": {
    "note": "Events are timed or for max reps; train with 30-60 s efforts and 2-4 min rest."
  },
  "mistakes": [
    {
      "id": "stone-straight",
      "name": "Lifting the stone with straight legs",
      "looks": "The stone is hauled up with the back, no lap, legs barely bent.",
      "fix": "Lap the stone, re-grip, then extend from the hips.",
      "why": "The stone forces a rounded back; without the legs the back takes even more load.",
      "pose": {
        "kneeFlex": -50,
        "lumbar": 15,
        "trunk": 10
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 50"
      },
      "refs": [
        "mcgill2009b",
        "hindle2021stone"
      ]
    },
    {
      "id": "tire-curl",
      "name": "Curling the tire",
      "looks": "The elbows bend and the arms pull the tire up.",
      "fix": "Arms straight; drive with the legs and chest into the tire.",
      "why": "A heavy curl with palms up is a known way to rupture the distal biceps.",
      "pose": {
        "elbowFlex": 60,
        "elbowFlexL": 60
      },
      "detect": {
        "metric": "elbowFlex",
        "bad": "> 30"
      },
      "refs": [
        "lorenz2022"
      ]
    },
    {
      "id": "tire-hips",
      "name": "Hips too high on the tire",
      "looks": "Legs nearly straight at the start, back rounded like a stiff-leg deadlift.",
      "fix": "Get low: chest on the tire, hips near knee height.",
      "why": "Puts the whole lift on the back and slows the second pull.",
      "pose": {
        "kneeFlex": -40,
        "hipFlex": -10,
        "lumbar": 20
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 60"
      },
      "refs": [
        "keogh2010tire"
      ]
    },
    {
      "id": "yoke-sway",
      "name": "Yoke sways",
      "looks": "The yoke rocks side to side or the steps get long and slow.",
      "fix": "Short fast steps, brace hard, eyes ahead.",
      "why": "The hips cannot hold the frontal load without a stiff trunk.",
      "pose": {
        "hipAbd": 10,
        "hipAbdL": -10
      },
      "detect": {
        "metric": "trunkSideLean",
        "bad": "> 8"
      },
      "refs": [
        "mcgill2009b",
        "hindle2021yoke"
      ]
    }
  ],
  "safety": [
    "These are high-load events; the yoke gave the highest spine loads of all tested events.",
    "Distal biceps: keep the arms straight in tire flips and stone lifts.",
    "Train under supervision, on a safe surface, and stop sets before technique fails."
  ],
  "variants": [
    {
      "when": "sandbag|shouldering|loading",
      "change": "Pick a bag or stone and load it to the shoulder or onto a platform; same lap-and-extend pattern."
    },
    {
      "when": "hold|cross|crucifix|hercules",
      "change": "Static hold: arms out to the sides or in front for time."
    },
    {
      "when": "car flip|fingal",
      "change": "Lift and push one end of a long object up and over, walking hand over hand."
    },
    {
      "when": "circle of conan",
      "change": "Push a lever arm on the shoulder around a circle: a loaded walk."
    },
    {
      "when": "mas wrestling",
      "change": "Seated tug of war on a stick: grip and back."
    },
    {
      "when": "apollon|axle|viking|iron block",
      "change": "Pressing events: like the log press with a thick bar, lever or block."
    }
  ],
  "easier": [
    "deadlift",
    "loaded-carry",
    "sandbag to shoulder"
  ],
  "harder": [
    "heavier implements",
    "event medleys"
  ],
