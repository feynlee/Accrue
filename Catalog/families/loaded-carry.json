{
  "id": "loaded-carry",
  "name": "Loaded carry",
  "kind": "strength",
  "bodyModel": "anatomy",
  "tracking": "weight_distance",
  "pattern": "Walking under load: a weight is held in the hands, at the chest, on the shoulder or overhead while the trunk stays tall and still.",
  "muscles": {
    "primary": [
      "wrist-flexors",
      "upper-traps",
      "obliques",
      "deep-core"
    ],
    "secondary": [
      "lower-back",
      "abs",
      "glute-med",
      "quads",
      "calves",
      "rotator-cuff",
      "heart-lungs"
    ]
  },
  "equipment": [
    "dumbbell",
    "kettlebell",
    "trap-bar",
    "barbell",
    "sandbag",
    "weighted",
    "plate"
  ],
  "setup": [
    "Deadlift the weights up with a flat back; never pick them up rounded.",
    "Stand tall: shoulders down and back, ribs over hips, eyes forward.",
    "Squeeze the handles hard and brace before the first step."
  ],
  "steps": [
    {
      "phase": "Right heel",
      "text": "Step out with short, quick, controlled steps."
    },
    {
      "phase": "Pass",
      "text": "Stay tall as one leg passes the other; no swaying."
    },
    {
      "phase": "Left heel",
      "text": "Keep walking heel to toe; set the weights down with a hinge at the end."
    }
  ],
  "cues": [
    {
      "joint": "trunk",
      "cue": "Walk tall; do not lean or twist.",
      "why": "Carries make the trunk muscles stiffen the spine against bending in every direction.",
      "refs": [
        "mcgill2009b",
        "ellestad2024"
      ]
    },
    {
      "joint": "shoulders",
      "cue": "Shoulders down and back, not shrugged or rounded.",
      "why": "A packed shoulder holds the load close and keeps the neck relaxed.",
      "refs": [
        "mcgill2009b"
      ]
    },
    {
      "joint": "steps",
      "cue": "Short quick steps.",
      "why": "Better carriers in the farmer's walk use a quick stride rate and short ground contacts.",
      "refs": [
        "hindle2019"
      ]
    },
    {
      "joint": "one side",
      "cue": "With one weight, stay level: do not lean away from it.",
      "why": "The suitcase carry adds work for the side muscles of the trunk.",
      "refs": [
        "ellestad2024",
        "mcgill2009b"
      ]
    },
    {
      "joint": "hips",
      "cue": "Keep the hips level at each step.",
      "why": "The gluteus medius works hard to hold the pelvis during a farmer's walk.",
      "refs": [
        "stastny2015"
      ]
    }
  ],
  "breathing": "Short breaths behind a braced belly; do not hold your breath for the whole walk.",
  "tempo": {
    "note": "Carry for 20-40 m or 20-60 s, rest, repeat."
  },
  "mistakes": [
    {
      "id": "lean",
      "name": "Leaning to one side",
      "looks": "With one weight, the trunk bends toward or away from it; with two, the body sways side to side.",
      "fix": "Lighter weight; ribs stacked over the hips.",
      "why": "The trunk muscles are losing the fight; spine load rises.",
      "pose": {
        "hipAbd": 8,
        "hipAbdL": -8
      },
      "detect": {
        "metric": "trunkSideLean",
        "bad": "> 8"
      },
      "refs": [
        "mcgill2009b",
        "ellestad2024"
      ]
    },
    {
      "id": "shrug",
      "name": "Shoulders round or shrug",
      "looks": "The weights pull the shoulders forward and up to the ears; the head pokes forward.",
      "fix": "Shoulders down and back, chest tall.",
      "why": "Neck and upper back strain; the load drifts from the body.",
      "pose": {
        "neck": 20,
        "scapula": {
          "protraction": 0.6,
          "elevation": 0.5
        }
      },
      "detect": {
        "metric": "shoulderElevation",
        "bad": "> 0.3"
      },
      "refs": [
        "mcgill2009b"
      ]
    },
    {
      "id": "arch",
      "name": "Low back arches (overhead)",
      "looks": "The arms drift forward and the low back leans back to balance the weight.",
      "fix": "Lighter weight; biceps by the ears, ribs down.",
      "why": "Shoulder mobility or core control is short for the load.",
      "pose": {
        "lumbar": -15,
        "shoulderFlex": -20,
        "shoulderFlexL": -20
      },
      "detect": {
        "metric": "lumbar",
        "bad": "< -10"
      },
      "refs": [
        "mcgill2012"
      ]
    }
  ],
  "safety": [
    "Pick up and put down the weights with a hinge, flat back.",
    "Clear the path; drop the weight forward if you lose the grip."
  ],
  "variants": [
    {
      "when": "farmer|trap bar|barbell farmers",
      "change": "Equal weights both hands: hardest on grip and upper back. Moderate pace with 23-68 kg is about 6.5 MET (17019)."
    },
    {
      "when": "suitcase|unilateral|single arm(?!.*overhead)",
      "change": "One weight in one hand: more side trunk work, about half the load."
    },
    {
      "when": "overhead",
      "change": "Arms locked overhead: shoulder stability; much lighter."
    },
    {
      "when": "bottoms up",
      "change": "Kettlebell held upside down: grip and shoulder control."
    },
    {
      "when": "goblet|front rack|zercher|bear hug|shield",
      "change": "Load in front of the chest: the upper back and abs work to stay upright."
    },
    {
      "when": "high low",
      "change": "One weight overhead, the other at the side."
    },
    {
      "when": "backpack|vest",
      "change": "Load on the back: easier on grip; the Compendium lists backpacking at 7.0 MET (17010)."
    },
    {
      "when": "shoulders|timber|sandbag walk",
      "change": "Load on one shoulder or across both: switch sides each set."
    }
  ],
  "easier": [
    "walk",
    "single light farmer carry"
  ],
  "harder": [
    "heavy farmer carry",
    "overhead carry",
    "strongman-event (yoke)"
  ],
