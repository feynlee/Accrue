{
  "id": "run",
  "name": "Running",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "running",
  "pattern": "Gait with a flight phase: you land under your body, spring off one foot and float before the other foot lands.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "calves",
      "heart-lungs"
    ],
    "secondary": [
      "hamstrings",
      "hip-flexors",
      "soleus",
      "glute-med",
      "abs"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Shoes that feel comfortable; no need to match a 'foot type'.",
    "Start with 5-10 minutes of easy jogging or brisk walking.",
    "Stand tall, eyes ahead about 20-30 m, shoulders loose."
  ],
  "steps": [
    {
      "phase": "Right foot lands",
      "text": "Land with your foot close under your hips, knee softly bent."
    },
    {
      "phase": "Right midstance",
      "text": "Let the knee and ankle bend a little to soak up the landing."
    },
    {
      "phase": "Right toe-off",
      "text": "Push the ground back and away; the hip extends behind you."
    },
    {
      "phase": "Left foot lands",
      "text": "Float, then land the other foot under you, arms swinging opposite."
    },
    {
      "phase": "Left midstance",
      "text": "Same soft load on the left; right heel comes up toward your seat."
    },
    {
      "phase": "Left toe-off",
      "text": "Push off left while the right knee swings forward, not up."
    }
  ],
  "cues": [
    {
      "joint": "feet",
      "cue": "Land under you, not out in front.",
      "why": "Landing with the foot and shin far ahead of the hips raises braking force and the load at the hip and knee.",
      "refs": [
        "lieberman2015",
        "wille2014"
      ]
    },
    {
      "joint": "cadence",
      "cue": "Quick, light steps: if you overstride, add 5-10% steps per minute.",
      "why": "A 5-10% higher step rate at the same speed shortens the stride and lowers knee and hip loading.",
      "refs": [
        "heiderscheit2011",
        "lenhart2014"
      ]
    },
    {
      "joint": "trunk",
      "cue": "Tall, with a slight lean from the ankles, not the waist.",
      "why": "Trunk lean changes how the hip and knee share the work; a big waist bend loads the hip and back.",
      "refs": [
        "folland2017"
      ]
    },
    {
      "joint": "bounce",
      "cue": "Run forward, not up: keep the bounce small.",
      "why": "Less vertical oscillation and less braking go with better running economy.",
      "refs": [
        "folland2017"
      ]
    },
    {
      "joint": "arms",
      "cue": "Elbows about 90°, hands swing by your hips, not across your chest.",
      "why": "Arm swing balances the rotation of the legs; crossing arms twist the trunk.",
      "refs": [
        "novacheck1998"
      ]
    },
    {
      "joint": "effort",
      "cue": "Most runs easy: you can still talk in full sentences.",
      "why": "Build weekly time slowly; sudden jumps in load are a common route to running injury.",
      "refs": [
        "souza2016"
      ]
    }
  ],
  "breathing": "Breathe through mouth and nose in an even rhythm; on easy runs you should be able to talk.",
  "tempo": {
    "note": "One loop = two steps. Easy running is usually 155-175 steps per minute; faster running raises it."
  },
  "mistakes": [
    {
      "id": "overstride",
      "name": "Overstriding",
      "looks": "The foot lands far ahead of the body with a nearly straight knee and a hard heel.",
      "fix": "Shorter, quicker steps; land with your foot under your knee.",
      "why": "It works like a brake each step and raises loading at the hip and knee.",
      "pose": {
        "hipFlex": 12,
        "kneeFlex": -12,
        "ankleDorsi": 10
      },
      "detect": {
        "metric": "kneeAtContact",
        "bad": "< 10"
      },
      "refs": [
        "lieberman2015",
        "wille2014",
        "heiderscheit2011"
      ]
    },
    {
      "id": "waist-bend",
      "name": "Bent at the waist",
      "looks": "Hips sit back and the chest folds forward.",
      "fix": "Stand tall, hips under you, lean from the ankles.",
      "why": "Folding at the hips shortens hip extension and loads the back.",
      "pose": {
        "trunk": 12,
        "hipFlex": 10
      },
      "detect": {
        "metric": "trunk",
        "bad": "> 15"
      },
      "refs": [
        "folland2017"
      ]
    },
    {
      "id": "bounce",
      "name": "Too much bounce",
      "looks": "The head rises and drops a lot each step.",
      "fix": "Think 'forward', quicker steps, push back not up.",
      "why": "Energy spent going up is wasted and each landing is harder.",
      "pose": {
        "ankleDorsi": -10,
        "kneeFlex": -8
      },
      "detect": {
        "metric": "bounce",
        "bad": "> 10"
      },
      "refs": [
        "folland2017"
      ]
    },
    {
      "id": "crossover-arms",
      "name": "Arms swing across",
      "looks": "Hands cross the middle of the chest and the shoulders twist.",
      "fix": "Swing the hands forward and back past your hips.",
      "why": "It adds trunk rotation that the legs must then correct.",
      "pose": {
        "shoulderAbd": -15,
        "shoulderRot": -20
      },
      "detect": {
        "metric": "handCross",
        "bad": "> 0"
      },
      "refs": [
        "novacheck1998"
      ]
    }
  ],
  "safety": [
    "New runners: mix running and walking and add no more than about 10% time per week.",
    "Sharp pain in a bone (shin, foot) that gets worse with each run: stop and get it checked.",
    "Knee pain at the front: try a 5-10% higher step rate and shorter runs.",
    "Heat: drink, slow down and stop if dizzy."
  ],
