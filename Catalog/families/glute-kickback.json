{
  "id": "glute-kickback",
  "name": "Glute kickback",
  "kind": "strength",
  "bodyModel": "anatomy",
  "tracking": "weight_reps",
  "pattern": "Single-leg hip extension: one leg drives back from the hip while the trunk and pelvis stay still.",
  "muscles": {
    "primary": [
      "glutes"
    ],
    "secondary": [
      "hamstrings",
      "glute-med",
      "lower-back",
      "deep-core"
    ]
  },
  "equipment": [
    "none",
    "cable-stack",
    "band",
    "machine",
    "dumbbell"
  ],
  "setup": [
    "On hands and knees: hands under shoulders, knees under hips, back flat.",
    "Working knee bent about 90°, foot flexed.",
    "Brace your belly so the low back stays still."
  ],
  "steps": [
    {
      "phase": "Kick",
      "text": "Drive the heel up and back toward the ceiling, knee still bent."
    },
    {
      "phase": "Top",
      "text": "Stop when the thigh is level with your body."
    },
    {
      "phase": "Squeeze",
      "text": "Squeeze the glute for a second."
    },
    {
      "phase": "Return",
      "text": "Lower the knee back under the hip without touching down."
    }
  ],
  "cues": [
    {
      "joint": "knee",
      "cue": "Keep the knee bent 90° or more.",
      "why": "A bent knee slackens the hamstrings so the glute does more of the work.",
      "refs": [
        "kwon2013",
        "jeon2016"
      ]
    },
    {
      "joint": "back",
      "cue": "Back flat like a table; stop when the thigh is level.",
      "why": "Lifting higher comes from arching the low back, not from the hip.",
      "refs": [
        "jeon2016",
        "sakamoto2009"
      ]
    },
    {
      "joint": "pelvis",
      "cue": "Hips square to the floor, do not twist open.",
      "why": "Rotation lets other muscles move the leg.",
      "refs": [
        "jeon2016"
      ]
    },
    {
      "joint": "tempo",
      "cue": "Slow, with a pause at the top.",
      "why": "The glute tends to switch on last in prone hip extension; a pause gives it time to work.",
      "refs": [
        "sakamoto2009"
      ]
    }
  ],
  "breathing": "Breathe out as you kick back, in as you return.",
  "tempo": {
    "down": 2,
    "pause": 1,
    "up": 1,
    "note": "Controlled; no swinging."
  },
  "mistakes": [
    {
      "id": "arch",
      "name": "Low back arches",
      "looks": "The leg goes higher than the body and the low back sinks.",
      "fix": "Brace, and stop when the thigh is level.",
      "why": "Range comes from the spine; the glute does less.",
      "pose": {
        "lumbar": -20,
        "hipFlex": -15
      },
      "detect": {
        "metric": "lumbar",
        "bad": "< -10"
      },
      "refs": [
        "jeon2016"
      ]
    },
    {
      "id": "twist",
      "name": "Hip twists open",
      "looks": "The working hip lifts and turns toward the ceiling.",
      "fix": "Keep both hip bones pointing at the floor.",
      "why": "Rotation takes the glute max out of a pure hip extension.",
      "pose": {
        "hipAbd": 20,
        "hipRot": 15
      },
      "detect": {
        "metric": "pelvisRotation",
        "bad": "> 10"
      },
      "refs": [
        "jeon2016"
      ]
    },
    {
      "id": "straighten",
      "name": "Knee straightens",
      "looks": "The leg kicks out straight as it rises.",
      "fix": "Hold the knee angle, push the heel to the ceiling.",
      "why": "A straight knee lets the hamstrings take over.",
      "pose": {
        "kneeFlex": -70
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 60"
      },
      "refs": [
        "kwon2013"
      ]
    }
  ],
  "safety": [
    "Wrist pain on all fours: use fists or forearms on a bench.",
    "Low back pain: keep the range short and the trunk braced."
  ],
  "variants": [
    {
      "when": "cable|band|ankle strap",
      "change": "Load pulls the foot forward: the start (hip bent) is harder, the top easier with a band."
    },
    {
      "when": "straight leg",
      "change": "Knee straight: longer lever, more hamstring."
    },
    {
      "when": "diagonal|cross|medius|side lying",
      "change": "Leg goes back and out: more glute medius."
    },
    {
      "when": "glute press|lever|smith",
      "change": "Machine pad on the foot or thigh; same hip action, fixed path."
    },
    {
      "when": "bench",
      "change": "Hands or trunk on a bench: less wrist load, same hip action."
    }
  ],
  "easier": [
    "prone hip extension",
    "glute bridge"
  ],
  "harder": [
    "cable kickback",
    "reverse hyperextension"
  ],
