{
  "id": "swim",
  "name": "Swimming",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "swimming",
  "pattern": "Lying long in the water, the arms pull you forward in turn or together while the legs kick to keep the hips high.",
  "muscles": {
    "primary": [
      "lats",
      "front-delts",
      "triceps",
      "heart-lungs"
    ],
    "secondary": [
      "chest",
      "rotator-cuff",
      "serratus-anterior",
      "abs",
      "glutes",
      "quads",
      "hip-flexors"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Goggles on and snug; cap if your hair is long.",
    "Push off the wall in a long streamline: arms by your ears, hands stacked.",
    "Lap pools: swim on the right of the lane, pass at the wall.",
    "Open water: never alone, bright cap, know your exit points."
  ],
  "steps": [
    {
      "phase": "Right hand enters and reaches",
      "text": "Hand enters in front of the shoulder, fingertips first, and reaches forward."
    },
    {
      "phase": "Right catch and pull",
      "text": "Bend the elbow so the forearm faces back, elbow higher than the hand, and pull under your body."
    },
    {
      "phase": "Right push past hip",
      "text": "Push the water back past your hip while the body rolls to the other side."
    },
    {
      "phase": "Right elbow-high recovery",
      "text": "Lift the elbow out first and swing the relaxed hand forward close to the water."
    }
  ],
  "cues": [
    {
      "joint": "body line",
      "cue": "Head down, eyes to the floor, hips at the surface.",
      "why": "Drag is the main brake in swimming; a lifted head drops the hips and legs.",
      "refs": [
        "toussaint1992"
      ]
    },
    {
      "joint": "roll",
      "cue": "Roll the body with each stroke, both sides, to breathe.",
      "why": "Too little roll on the breathing side and one-sided breathing were tied to shoulder impingement.",
      "refs": [
        "yanai2000",
        "psycharakis2008"
      ]
    },
    {
      "joint": "hand entry",
      "cue": "Enter in line with your shoulder, never across your head.",
      "why": "Crossing the midline at entry pinches the rotator cuff under the shoulder roof.",
      "refs": [
        "yanai2000",
        "heinlein2010"
      ]
    },
    {
      "joint": "elbow",
      "cue": "High elbow catch: forearm vertical early, elbow above the hand.",
      "why": "A dropped elbow pushes water down instead of back and loads the front of the shoulder.",
      "refs": [
        "heinlein2010"
      ]
    },
    {
      "joint": "kick",
      "cue": "Kick from the hips, small and fast, toes pointed.",
      "why": "The kick mainly keeps the legs up; big knee-driven kicks add drag.",
      "refs": [
        "toussaint1992"
      ]
    },
    {
      "joint": "breathing",
      "cue": "Breathe out under water all the time, turn to breathe in.",
      "why": "Holding air makes you rush and lift your head to breathe.",
      "refs": [
        "psycharakis2011"
      ]
    }
  ],
  "breathing": "Exhale steadily through nose and mouth under water; turn the head with the body roll to inhale. Freestyle: every 2-3 strokes, both sides if you can.",
  "tempo": {
    "note": "One loop = one full arm cycle (both arms). Easy freestyle is about 30-45 cycles per minute."
  },
  "mistakes": [
    {
      "id": "head-up",
      "name": "Head up, hips sink",
      "looks": "Eyes forward, chin up, legs angled down in the water.",
      "fix": "Look at the floor, press your chest down slightly.",
      "why": "The body tilts and frontal drag rises sharply.",
      "pose": {
        "neck": -30,
        "trunk": -12
      },
      "detect": {
        "metric": "bodyAngle",
        "bad": "> 10"
      },
      "refs": [
        "toussaint1992"
      ]
    },
    {
      "id": "crossover",
      "name": "Hand crosses the midline",
      "looks": "The hand enters in front of the head or across the centre line.",
      "fix": "Enter wide, in front of the same shoulder.",
      "why": "It pinches the shoulder and makes the hips snake sideways.",
      "pose": {
        "shoulderAbd": -15
      },
      "detect": {
        "metric": "handEntry",
        "bad": "crosses midline"
      },
      "refs": [
        "yanai2000"
      ]
    },
    {
      "id": "flat",
      "name": "Swimming flat",
      "looks": "Shoulders stay level; the head lifts or twists to breathe.",
      "fix": "Roll about 40-50° to each side, head turns with the body.",
      "why": "Low roll on the breathing side went with shoulder impingement.",
      "pose": {
        "neck": -15,
        "shoulderAbd": 15
      },
      "detect": {
        "metric": "bodyRoll",
        "bad": "< 30"
      },
      "refs": [
        "yanai2000",
        "psycharakis2011"
      ]
    },
    {
      "id": "dropped-elbow",
      "name": "Dropped elbow",
      "looks": "The arm pulls straight and the elbow sinks below the hand.",
      "fix": "Bend the elbow early, like reaching over a barrel.",
      "why": "Less push back and more stress on the front of the shoulder.",
      "pose": {
        "elbowFlex": -60
      },
      "detect": {
        "metric": "elbowFlexPull",
        "bad": "< 50"
      },
      "refs": [
        "heinlein2010"
      ]
    }
  ],
  "safety": [
    "Shoulder pain: shorten sessions, breathe both sides, mix in backstroke, check hand entry.",
    "Breaststroke knee pain on the inside: narrow the kick and warm up gradually.",
    "Open water: swim with others, near shore, with a bright cap or buoy; cold water below 15 °C needs a gradual entry.",
    "Never practise breath-holding swims alone (risk of blackout)."
  ],
