{
  "id": "pilates-mat",
  "name": "Pilates mat",
  "kind": "core",
  "bodyModel": "anatomy",
  "tracking": "reps",
  "pattern": "Controlled trunk curls, rolls, leg reaches and extensions on a mat, done slowly with the breath while the deep abdominals hold the pelvis steady.",
  "muscles": {
    "primary": [
      "abs",
      "deep-core"
    ],
    "secondary": [
      "obliques",
      "hip-flexors",
      "lower-back",
      "glutes",
      "hamstrings",
      "adductors",
      "neck-flexors"
    ]
  },
  "equipment": [
    "mat"
  ],
  "setup": [
    "Lie on your back on a mat, knees bent, feet flat, arms by your sides.",
    "Find a neutral pelvis: hip bones and pubic bone level.",
    "Draw your lower belly gently in toward the spine before you move."
  ],
  "steps": [
    {
      "phase": "Start",
      "text": "Lie long, legs together, arms reaching overhead."
    },
    {
      "phase": "Curl",
      "text": "Breathe in, lift the arms and head; breathe out and peel the spine off the mat one bone at a time."
    },
    {
      "phase": "Reach",
      "text": "Fold over your legs, belly scooped, reaching past your toes."
    },
    {
      "phase": "Roll down",
      "text": "Breathe in and roll back down slowly, one bone at a time, until the head returns."
    }
  ],
  "cues": [
    {
      "joint": "belly",
      "cue": "Draw your lower belly in and up before each move.",
      "why": "Hollowing turns on the transversus abdominis and internal oblique most selectively.",
      "refs": [
        "jung2022",
        "tsartsapakis2023"
      ]
    },
    {
      "joint": "pelvis",
      "cue": "Keep the pelvis still while the legs move.",
      "why": "Bracing reduced unwanted pelvic rotation in leg-pull work.",
      "refs": [
        "jung2022",
        "queiroz2010"
      ]
    },
    {
      "joint": "spine",
      "cue": "Roll one bone at a time; no jerks or swings.",
      "why": "Control, precision and flow are core Pilates principles; momentum takes the work off the trunk.",
      "refs": [
        "wells2012"
      ]
    },
    {
      "joint": "neck",
      "cue": "Chin a fist from the chest, eyes to your knees.",
      "why": "Keeps the neck long while the trunk curls; a tense neck often means the abs have let go.",
      "refs": [
        "wells2012"
      ]
    },
    {
      "joint": "breath",
      "cue": "Breathe out on the effort, in to prepare.",
      "why": "Breathing is the Pilates principle used most consistently in research and rehab programmes.",
      "refs": [
        "wells2012"
      ]
    }
  ],
  "breathing": "Breathe in to prepare, out as you curl, reach or press. Hundred: in for 5 pumps, out for 5.",
  "tempo": {
    "down": 3,
    "pause": 0,
    "up": 3,
    "note": "Slow and even, about 3 s each way; 5-10 reps of each exercise."
  },
  "mistakes": [
    {
      "id": "back-arch",
      "name": "Low back peels off the mat",
      "looks": "When the legs reach long, the low back arches up off the mat.",
      "fix": "Raise the legs higher or bend the knees until the back stays down.",
      "why": "The legs out-lever the abs; the load moves to the lower back.",
      "pose": {
        "lumbar": -15,
        "hipFlex": -15
      },
      "detect": {
        "metric": "lumbar",
        "bad": "< -10"
      },
      "refs": [
        "tsartsapakis2023",
        "jung2022"
      ]
    },
    {
      "id": "momentum",
      "name": "Throws up with momentum",
      "looks": "Arms swing and the feet lift as you jerk up in the roll up or teaser.",
      "fix": "Slow down; bend the knees or hold the backs of the thighs.",
      "why": "Momentum skips the controlled curl that trains the trunk.",
      "pose": {
        "hipFlex": -10,
        "lumbar": -10
      },
      "detect": {
        "metric": "trunkSpeed",
        "bad": "> 90 deg/s"
      },
      "refs": [
        "wells2012"
      ]
    },
    {
      "id": "neck-pull",
      "name": "Neck strain",
      "looks": "Chin jams to the chest or the hands pull the head.",
      "fix": "Fist space under the chin, lift from the breastbone.",
      "why": "The neck flexors tire long before the abs.",
      "pose": {
        "neck": 25
      },
      "detect": {
        "metric": "neck",
        "bad": "> 45"
      },
      "refs": [
        "wells2012"
      ]
    }
  ],
  "safety": [
    "Low back pain: Pilates helps pain and function about as much as other exercise; start with bent-knee versions.",
    "Osteoporosis: skip rolling-on-the-spine moves (rolling like a ball, rollover, jackknife, seal) and loaded forward flexion.",
    "Neck pain: keep the head down for the hundred and stretches.",
    "Pregnancy after the first trimester: avoid long work lying flat on the back."
  ],
  "variants": [
    {
      "when": "bent knee|v\\. 2",
      "change": "Knees bent: shorter lever, easier for the abs."
    },
    {
      "when": "kneeling",
      "change": "Side kicks from kneeling on one knee with one hand down: more balance work, less range."
    },
    {
      "when": "supported",
      "change": "Hands or forearms support the trunk: easier."
    }
  ],
  "easier": [
    "dead-bug-bird-dog",
    "crunch-sit-up"
  ],
  "harder": [
    "pilates-reformer",
    "full teaser",
    "jackknife"
  ],
