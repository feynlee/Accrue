{
  "id": "treadmill-run",
  "name": "Treadmill",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "running",
  "sessionMetrics": [
    "distance",
    "pace",
    "incline"
  ],
  "pattern": "Running or walking gait on a moving belt: same stride as outdoors, with the belt setting the speed.",
  "muscles": {
    "primary": [
      "heart-lungs",
      "quads",
      "glutes",
      "calves"
    ],
    "secondary": [
      "hamstrings",
      "hip-flexors",
      "soleus",
      "abs",
      "shins"
    ]
  },
  "equipment": [
    "treadmill"
  ],
  "setup": [
    "Straddle the belt, start it slow, then step on.",
    "Clip the safety key to your clothes.",
    "Run in the middle of the belt, close enough to reach the console."
  ],
  "steps": [
    {
      "phase": "Contact",
      "text": "Land softly with the foot close under your hips."
    },
    {
      "phase": "Midstance",
      "text": "Knee and ankle bend to absorb, body tall over the foot."
    },
    {
      "phase": "Toe-off",
      "text": "Push off behind you; the other knee swings through."
    },
    {
      "phase": "Swing",
      "text": "Heel comes up under the hip and the leg reaches for the next step."
    }
  ],
  "cues": [
    {
      "joint": "stride",
      "cue": "Short, quick steps; land under your hips.",
      "why": "Raising step rate 5-10% cuts the load on the knee and hip.",
      "refs": [
        "heiderscheit2011"
      ]
    },
    {
      "joint": "hands",
      "cue": "Let go of the rails; arms swing at your sides.",
      "why": "Holding the rails lowers the real effort and makes the console readings wrong.",
      "refs": [
        "acsm-guidelines"
      ]
    },
    {
      "joint": "posture",
      "cue": "Tall, eyes forward, slight lean from the ankles.",
      "why": "Looking down at your feet rounds the upper back.",
      "refs": [
        "acsm-guidelines"
      ]
    },
    {
      "joint": "belt",
      "cue": "Set a 1% incline to feel like flat running outdoors.",
      "why": "Treadmill running is close to overground running but with small changes in gait; a small incline offsets the missing air resistance.",
      "refs": [
        "vanhooren2020"
      ]
    }
  ],
  "breathing": "Find a rhythm, such as in for 2-3 steps and out for 2-3.",
  "tempo": {
    "note": "Running cadence about 160-180 steps a minute; walking about 100-120."
  },
  "mistakes": [
    {
      "id": "rails",
      "name": "Holding the rails",
      "looks": "Hands grip the front or side rails, often on an incline.",
      "fix": "Lower the speed or incline until you can let go.",
      "why": "The arms carry body weight; effort and calories are lower than the console shows.",
      "pose": {
        "shoulderFlex": 45,
        "shoulderFlexL": 45,
        "elbowFlex": -50,
        "elbowFlexL": -50,
        "trunk": -8
      },
      "detect": {
        "metric": "handsOnRail",
        "bad": "true"
      },
      "refs": [
        "acsm-guidelines"
      ]
    },
    {
      "id": "overstride",
      "name": "Over-striding",
      "looks": "The heel lands far in front with a straight knee.",
      "fix": "Shorter, quicker steps.",
      "why": "It raises braking force and knee load.",
      "pose": {
        "hipFlex": 12,
        "kneeFlex": -10,
        "ankleDorsi": 10
      },
      "detect": {
        "metric": "footAhead",
        "bad": "> 0.3 leg length"
      },
      "refs": [
        "heiderscheit2011"
      ]
    },
    {
      "id": "front",
      "name": "Running at the front edge",
      "looks": "Toes near the motor cover, stride cut short.",
      "fix": "Move back to the middle of the belt.",
      "why": "High trip risk on the cover.",
      "pose": {},
      "detect": {
        "metric": "beltPosition",
        "bad": "front 20%"
      },
      "refs": [
        "acsm-guidelines"
      ]
    }
  ],
  "safety": [
    "Always clip the safety key.",
    "Step to the side rails before stopping the belt; do not jump off a moving belt."
  ],
  "variants": [
    {
      "when": "walk",
      "change": "Walking 3.0-3.4 mph: 3.8 MET (17355); 3.5-3.9 mph: 4.8 MET (17358); 4.0-4.4 mph: 5.8 MET (17361).",
