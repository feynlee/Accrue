{
  "id": "team-sport",
  "name": "Team sports",
  "kind": "sport",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "basketball",
  "pattern": "Stop-and-go running with jumps, landings, cuts and kicks or shots, repeated over a game.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "hamstrings",
      "calves",
      "heart-lungs"
    ],
    "secondary": [
      "hip-flexors",
      "adductors",
      "glute-med",
      "abs",
      "obliques",
      "front-delts",
      "triceps"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Shoes for the surface: court shoes for basketball, studs or turf shoes for soccer.",
    "Warm up 10-15 minutes with a structured routine (jogging, strength, landing and cutting drills).",
    "Shin guards for soccer; consider an ankle brace if you have sprained it before."
  ],
  "steps": [
    {
      "phase": "Dip: ball set, knees bent",
      "text": "Bend hips and knees together, ball set above your shooting eye, elbow under the ball."
    },
    {
      "phase": "Jump and release at the top",
      "text": "Drive up through the legs and release as you near the top, wrist snapping forward."
    },
    {
      "phase": "Land softly on both feet",
      "text": "Land where you took off, on both feet, hips and knees bending, knees over toes."
    },
    {
      "phase": "Back to ready",
      "text": "Athletic stance: knees bent, weight on the balls of the feet."
    }
  ],
  "cues": [
    {
      "joint": "knees",
      "cue": "On every landing and cut, knees stay over your toes, never caving in.",
      "why": "Higher knee valgus angle and load on landing predicted ACL injury in a prospective study.",
      "refs": [
        "hewett2005"
      ]
    },
    {
      "joint": "landing",
      "cue": "Land soft and quiet: hips and knees bend together.",
      "why": "A simple 'land softly' instruction lowers impact force and increases knee bend.",
      "refs": [
        "milner2012"
      ]
    },
    {
      "joint": "cutting",
      "cue": "Slow down with short steps before a sharp cut.",
      "why": "Sharper cuts at higher speed raise knee loading; braking over the steps before the cut spreads it out.",
      "refs": [
        "dossantos2018"
      ]
    },
    {
      "joint": "warm-up",
      "cue": "Do a full injury-prevention warm-up (like FIFA 11+) before games.",
      "why": "In youth female soccer a structured warm-up cut injuries by about a third and severe injuries by about half.",
      "refs": [
        "soligard2008"
      ]
    },
    {
      "joint": "kick",
      "cue": "Soccer: plant beside the ball, knee over it, toes pointed on an instep drive.",
      "why": "Plant-foot position and a firm, extended ankle at impact set ball speed and direction.",
      "refs": [
        "kellis2007"
      ]
    }
  ],
  "breathing": "Breathe freely; use stoppages to slow your breathing.",
  "tempo": {
    "note": "Intermittent: sprints, jumps and cuts every few seconds with walking and jogging between. One loop = one move."
  },
  "mistakes": [
    {
      "id": "knee-valgus",
      "name": "Knees cave in",
      "looks": "On landing or cutting the knee collapses inside the foot.",
      "fix": "Push the knees out over the toes; strengthen the hips.",
      "why": "This pattern predicted ACL injury.",
      "pose": {
        "hipAbd": -10,
        "hipRot": -15,
        "hipAbdL": -10,
        "hipRotL": -15
      },
      "detect": {
        "metric": "kneeValgus",
        "bad": "> 10"
      },
      "refs": [
        "hewett2005"
      ]
    },
    {
      "id": "stiff-landing",
      "name": "Stiff landing",
      "looks": "Lands on straight legs, loud, upright trunk.",
      "fix": "Land softly, bend hips and knees, chest over knees.",
      "why": "Higher impact forces and less knee bend raise ACL and knee stress.",
      "pose": {
        "kneeFlex": -30,
        "kneeFlexL": -30,
        "hipFlex": -25,
        "hipFlexL": -25
      },
      "detect": {
        "metric": "landingKnee",
        "bad": "< 30"
      },
      "refs": [
        "milner2012"
      ]
    },
    {
      "id": "late-brake",
      "name": "Cutting at full speed",
      "looks": "One big plant step at full speed, trunk leaning away from the new direction.",
      "fix": "Brake over 2-3 short steps, lean into the cut.",
      "why": "Late braking and sharp angles raise knee loads.",
      "pose": {
        "trunk": -10,
        "hipAbd": 15,
        "kneeFlex": -15
      },
      "detect": {
        "metric": "approachSpeed",
        "bad": "no slowing before cut > 45°"
      },
      "refs": [
        "dossantos2018"
      ]
    }
  ],
  "safety": [
    "A previous ankle sprain raises the risk of another; brace or tape and do balance training.",
    "Landing is the most common way basketball ankle injuries happen, often on another player's foot.",
    "Concussion signs after a head knock: stop playing for the day.",
    "Build up game time gradually after a break."
  ],
