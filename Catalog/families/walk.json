{
  "id": "walk",
  "name": "Walking",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "walking",
  "pattern": "Gait with one foot always on the ground: heel lands, you roll over the foot and push off from the toes.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "calves",
      "heart-lungs"
    ],
    "secondary": [
      "hamstrings",
      "hip-flexors",
      "shins",
      "glute-med",
      "abs"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Comfortable shoes with some grip; for hikes, ankle support if the trail is rough.",
    "Stand tall, eyes ahead, shoulders relaxed and down.",
    "Start at an easy pace for a few minutes, then pick it up."
  ],
  "steps": [
    {
      "phase": "Right heel strikes",
      "text": "Land on the heel with the knee nearly straight, foot not far in front."
    },
    {
      "phase": "Right loads",
      "text": "Roll onto the whole foot; the knee bends slightly to take your weight."
    },
    {
      "phase": "Right midstance",
      "text": "Your body passes over the foot, standing tall."
    },
    {
      "phase": "Left heel strikes",
      "text": "The left heel lands as the right heel lifts."
    },
    {
      "phase": "Right swings",
      "text": "Push off the right toes; the knee bends and the foot swings through."
    },
    {
      "phase": "Right reaches",
      "text": "The right leg reaches forward to land again, arms swinging opposite."
    }
  ],
  "cues": [
    {
      "joint": "pace",
      "cue": "For exercise, walk at 100+ steps per minute; 130 is vigorous.",
      "why": "About 100 steps/min is a simple marker of moderate intensity (about 3 MET) in adults.",
      "refs": [
        "tudorlocke2018"
      ]
    },
    {
      "joint": "steps",
      "cue": "To go faster, take quicker steps, not longer ones.",
      "why": "Reaching far ahead turns the heel strike into a brake; speed comes mostly from step rate and push-off.",
      "refs": [
        "kadaba1990"
      ]
    },
    {
      "joint": "posture",
      "cue": "Tall, head over shoulders, eyes ahead.",
      "why": "Looking down drops the head forward and rounds the upper back.",
      "refs": [
        "attwells2006"
      ]
    },
    {
      "joint": "arms",
      "cue": "Elbows bent, arms swing from the shoulder.",
      "why": "Arm swing balances the legs and helps brisk pace; with poles it adds upper-body work.",
      "refs": [
        "tschentscher2013"
      ]
    },
    {
      "joint": "downhill",
      "cue": "Downhill: shorter steps, soft knees, use poles if you have them.",
      "why": "Poles cut knee joint forces by roughly 12-25% walking downhill.",
      "refs": [
        "schwameder1999",
        "bohne2007"
      ]
    }
  ],
  "breathing": "Breathe naturally. At a brisk pace you can talk but not sing.",
  "tempo": {
    "note": "One loop = two steps. Easy walking is about 90-100 steps per minute, brisk 110-130."
  },
  "mistakes": [
    {
      "id": "overstride",
      "name": "Reaching too far",
      "looks": "The front heel lands far ahead with a locked knee.",
      "fix": "Shorter, quicker steps; push off with the back foot.",
      "why": "Long reaches brake every step and load the shin and knee.",
      "pose": {
        "hipFlex": 10,
        "kneeFlex": -3,
        "ankleDorsi": 10
      },
      "detect": {
        "metric": "stepLength",
        "bad": "> 0.45 x height"
      },
      "refs": [
        "kadaba1990"
      ]
    },
    {
      "id": "head-down",
      "name": "Head down, slumped",
      "looks": "Chin toward the chest, upper back rounded, eyes on the feet.",
      "fix": "Eyes 10-20 m ahead, chest tall.",
      "why": "The head drifts forward, especially with a pack or when tired.",
      "pose": {
        "neck": 25,
        "trunk": 8
      },
      "detect": {
        "metric": "neck",
        "bad": "> 20"
      },
      "refs": [
        "attwells2006"
      ]
    },
    {
      "id": "pack-lean",
      "name": "Leaning under a pack",
      "looks": "With a pack, the trunk tips well forward from the hips.",
      "fix": "Lighten the pack, load heavy items high and close, tighten the hip belt.",
      "why": "Heavy loads push the trunk and head forward and raise back and foot stress.",
      "pose": {
        "trunk": 12,
        "neck": 10
      },
      "detect": {
        "metric": "trunk",
        "bad": "> 20"
      },
      "refs": [
        "attwells2006",
        "knapik2004"
      ]
    }
  ],
  "safety": [
    "Rucking: start at about 10% of body weight and add load slowly; blisters and foot pain come first.",
    "Hiking: carry water, check the weather and tell someone your route.",
    "Balance problems: walk on even ground, use a pole or a rail.",
    "Chest pain or unusual breathlessness: stop and seek help."
  ],
