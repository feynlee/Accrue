{
  "id": "racket-sport",
  "name": "Racket sports",
  "kind": "sport",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "tennis",
  "pattern": "Short bursts: split step, move to the ball, set the feet, swing from the legs and trunk through the arm, recover to the middle.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "obliques",
      "heart-lungs"
    ],
    "secondary": [
      "calves",
      "adductors",
      "front-delts",
      "rotator-cuff",
      "chest",
      "wrist-extensors",
      "wrist-flexors",
      "triceps"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Court shoes for your surface: they grip side-to-side and support the ankle.",
    "Grip: hold the racket or paddle relaxed, like a handshake.",
    "Warm up 5-10 minutes: easy rallies, side shuffles, a few lunges.",
    "Squash and badminton: wear eye protection if your club advises it."
  ],
  "steps": [
    {
      "phase": "Split step, ready",
      "text": "Small hop as your opponent hits, landing on the balls of your feet, knees bent."
    },
    {
      "phase": "Turn and take the racket back",
      "text": "Turn your shoulders and hips sideways as you move; racket goes back early."
    },
    {
      "phase": "Contact in front of the body",
      "text": "Step in, push from the legs, rotate the trunk and meet the ball in front of you."
    },
    {
      "phase": "Follow through over the shoulder",
      "text": "Let the swing finish over the opposite shoulder, then recover to the middle."
    }
  ],
  "cues": [
    {
      "joint": "feet",
      "cue": "Split step every time your opponent hits.",
      "why": "Skilled players time a split step with the opponent's contact so they can push off in any direction.",
      "refs": [
        "filipcic2017"
      ]
    },
    {
      "joint": "trunk",
      "cue": "Swing from the legs and trunk; the arm finishes the chain.",
      "why": "Most stroke energy comes from the legs and trunk; an arm-only swing loads the shoulder and elbow.",
      "refs": [
        "dines2015"
      ]
    },
    {
      "joint": "wrist",
      "cue": "Backhand: wrist firm and slightly back at contact, not bending forward.",
      "why": "Novices who hit with a flexing wrist load the forearm extensors, the classic route to tennis elbow.",
      "refs": [
        "blackwell1994"
      ]
    },
    {
      "joint": "lunge",
      "cue": "Lunge with the knee over the toes, heel first, then push straight back.",
      "why": "The lead knee and ankle take large braking forces in badminton and squash lunges.",
      "refs": [
        "kuntze2010"
      ]
    },
    {
      "joint": "contact",
      "cue": "Hit in front of your body, not beside or behind it.",
      "why": "Late contact forces the arm and wrist to rescue the shot.",
      "refs": [
        "dines2015"
      ]
    }
  ],
  "breathing": "Breathe out as you hit; recover your breath between points.",
  "tempo": {
    "note": "Rallies last a few seconds with short rests; one loop = one shot from ready to recovery."
  },
  "mistakes": [
    {
      "id": "flat-feet",
      "name": "Flat-footed",
      "looks": "Standing tall on the heels, no split step, reaching for the ball.",
      "fix": "Knees bent, weight on the balls of the feet, split step on the opponent's hit.",
      "why": "You arrive late and stretch with the arm.",
      "pose": {
        "kneeFlex": -30,
        "kneeFlexL": -30,
        "hipFlex": -25,
        "hipFlexL": -25,
        "ankleDorsi": -15,
        "ankleDorsiL": -15
      },
      "detect": {
        "metric": "readyKnee",
        "bad": "< 20"
      },
      "refs": [
        "filipcic2017"
      ]
    },
    {
      "id": "wrist-backhand",
      "name": "Wrist-led backhand",
      "looks": "The wrist bends forward at contact and the elbow leads.",
      "fix": "Lead with the shoulder, wrist firm; try a two-handed backhand.",
      "why": "Repeated forearm extensor strain causes tennis elbow.",
      "pose": {
        "wristExt": -30
      },
      "detect": {
        "metric": "wristAtContact",
        "bad": "< 0"
      },
      "refs": [
        "blackwell1994"
      ]
    },
    {
      "id": "knee-in-lunge",
      "name": "Knee caves in the lunge",
      "looks": "The front knee drops inward or far past the toes.",
      "fix": "Point the foot to the ball and keep the knee in line with it.",
      "why": "It twists the knee under high braking load.",
      "pose": {
        "hipAbd": -10,
        "hipRot": -15,
        "kneeFlex": 15
      },
      "detect": {
        "metric": "kneeValgus",
        "bad": "> 10"
      },
      "refs": [
        "kuntze2010"
      ]
    },
    {
      "id": "arm-only",
      "name": "Arm-only swing",
      "looks": "Feet and shoulders stay facing the net while the arm swings.",
      "fix": "Turn sideways early and rotate through the shot.",
      "why": "Shoulder and elbow do the work the legs and trunk should do.",
      "pose": {
        "shoulderAbd": 20,
        "elbowFlex": 30
      },
      "detect": {
        "metric": "shoulderTurn",
        "bad": "< 45 at backswing"
      },
      "refs": [
        "dines2015"
      ]
    }
  ],
  "safety": [
    "Pickleball: many injuries are falls, sprains and strains, mostly in older players; do not backpedal for lobs, turn and move sideways.",
    "Sudden calf or heel pain on a push-off (Achilles): stop at once.",
    "Elbow pain on the outside: check grip size, strings and backhand technique.",
    "Squash: stay out of your opponent's swing; let a point go rather than run into them."
  ],
