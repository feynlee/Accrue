{
  "id": "jumping-jack",
  "name": "Jumping jack",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "highIntensityIntervalTraining",
  "sessionMetrics": [
    "reps"
  ],
  "pattern": "Jump the feet out and in while the arms sweep up overhead and down to the sides.",
  "muscles": {
    "primary": [
      "heart-lungs",
      "calves",
      "glute-med"
    ],
    "secondary": [
      "adductors",
      "quads",
      "side-delts",
      "front-delts",
      "shins",
      "abs"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Stand tall, feet together, arms by your sides.",
    "Weight on the balls of the feet, knees soft."
  ],
  "steps": [
    {
      "phase": "Out",
      "text": "Jump the feet just wider than the shoulders as the arms sweep up."
    },
    {
      "phase": "Wide",
      "text": "Land softly, knees bent, hands meet overhead."
    },
    {
      "phase": "In",
      "text": "Jump the feet back together as the arms sweep down."
    }
  ],
  "cues": [
    {
      "joint": "landing",
      "cue": "Land on the balls of the feet, knees soft.",
      "why": "Soft landings lower the impact on knees and shins.",
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "joint": "knees",
      "cue": "Knees point the same way as the toes.",
      "why": "Knees caving in on landing is a known sign of poor control linked to knee injury.",
      "refs": [
        "hewett2005"
      ]
    },
    {
      "joint": "arms",
      "cue": "Arms straight but not locked, full sweep.",
      "why": "The full arm range adds shoulder work and keeps the rhythm.",
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "joint": "pace",
      "cue": "Steady rhythm you can hold for the whole set.",
      "why": "Vigorous calisthenics like jacks reach about 7.5 MET.",
      "refs": [
        "herrmann2024"
      ]
    }
  ],
  "breathing": "Breathe in rhythm, such as out every second jump.",
  "tempo": {
    "note": "About 1 jack a second; one loop is out and in."
  },
  "mistakes": [
    {
      "id": "valgus",
      "name": "Knees cave in",
      "looks": "Knees fall inward when the feet land wide.",
      "fix": "Push the knees out over the toes.",
      "why": "Inward collapse loads the knee ligaments.",
      "pose": {
        "hipRot": -15,
        "hipRotL": -15,
        "hipAbd": -5,
        "hipAbdL": -5
      },
      "detect": {
        "metric": "kneeValgus",
        "bad": "> 10"
      },
      "refs": [
        "hewett2005"
      ]
    },
    {
      "id": "stiff",
      "name": "Stiff-legged landing",
      "looks": "Knees locked, flat-footed thump.",
      "fix": "Land on the forefoot and let the knees bend.",
      "why": "Shock goes straight to the knees and back.",
      "pose": {
        "kneeFlex": -15,
        "kneeFlexL": -15,
        "ankleDorsi": -10,
        "ankleDorsiL": -10
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 5 at landing"
      },
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "id": "half-arms",
      "name": "Half arm swing",
      "looks": "Hands stop at shoulder height.",
      "fix": "Sweep the hands all the way overhead.",
      "why": "Less work and broken rhythm.",
      "pose": {
        "shoulderAbd": -80,
        "shoulderAbdL": -80
      },
      "detect": {
        "metric": "shoulderAbd",
        "bad": "< 140 at top"
      },
      "refs": [
        "nsca-estc"
      ]
    }
  ],
  "safety": [
    "Low impact: step one foot out at a time (jack step)."
  ],
  "variants": [
