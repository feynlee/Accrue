{
  "id": "sled-push-pull",
  "name": "Sled push, drag and pull",
  "kind": "power",
  "bodyModel": "skin",
  "tracking": "weight_distance",
  "pattern": "Loaded locomotion: the legs drive the ground back in short powerful steps while the trunk leans into a weighted sled.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "calves"
    ],
    "secondary": [
      "hamstrings",
      "hip-flexors",
      "front-delts",
      "triceps",
      "chest",
      "abs",
      "deep-core",
      "heart-lungs"
    ]
  },
  "equipment": [
    "sled",
    "strap"
  ],
  "setup": [
    "Load the sled so you can keep moving without stopping; check the surface.",
    "Hands on the poles, arms nearly straight, body leaning about 45°.",
    "Head in line with the spine, one foot back ready to drive."
  ],
  "steps": [
    {
      "phase": "Right step",
      "text": "Drive the back leg into the ground and push it long behind you."
    },
    {
      "phase": "Drive",
      "text": "Bring the other knee through low and fast; keep the lean."
    },
    {
      "phase": "Left step",
      "text": "Plant the foot under your hips, on the ball of the foot, and drive again."
    }
  ],
  "cues": [
    {
      "joint": "trunk",
      "cue": "Lean in with a straight line from head to back heel.",
      "why": "A strong forward lean lets you push harder; pushing force grows with body lean.",
      "refs": [
        "sanjaya2014",
        "keogh2010sled"
      ]
    },
    {
      "joint": "steps",
      "cue": "Short, quick, powerful steps.",
      "why": "Faster sled efforts come from longer strides, quicker steps and shorter ground contact.",
      "refs": [
        "keogh2010sled",
        "hindle2019"
      ]
    },
    {
      "joint": "feet",
      "cue": "Push through the balls of the feet, heels up.",
      "why": "Heavier sleds raise calf and quad demand.",
      "refs": [
        "martinezserrano2021"
      ]
    },
    {
      "joint": "load",
      "cue": "Light sled for speed, heavy sled for strength.",
      "why": "Heavier loads change sprint posture more: more trunk lean, more hip and knee bend, longer contacts.",
      "refs": [
        "lockie2003",
        "martinezserrano2021"
      ]
    },
    {
      "joint": "back",
      "cue": "Brace; do not let the hips sag or the back round.",
      "why": "The trunk passes the leg drive into the sled.",
      "refs": [
        "keogh2010sled"
      ]
    }
  ],
  "breathing": "Short rhythmic breaths with the steps; brace on each drive.",
  "tempo": {
    "note": "Work in bouts of about 10-30 m or 10-30 s with full rest for power, shorter rests for conditioning."
  },
  "mistakes": [
    {
      "id": "upright",
      "name": "Standing too upright",
      "looks": "Shoulders above the hips, arms bent, short pushes from the arms.",
      "fix": "Lean in about 45°, arms long, push from the legs.",
      "why": "Less of the leg drive goes into the sled.",
      "pose": {
        "trunk": -25,
        "elbowFlex": 60
      },
      "detect": {
        "metric": "trunk",
        "bad": "< 25"
      },
      "refs": [
        "sanjaya2014"
      ]
    },
    {
      "id": "sag",
      "name": "Hips sag or back rounds",
      "looks": "The hips drop or the spine curves between the hands and feet.",
      "fix": "Brace like a plank; lighter sled.",
      "why": "Force leaks out through the trunk.",
      "pose": {
        "lumbar": 20
      },
      "detect": {
        "metric": "lumbar",
        "bad": "> 15"
      },
      "refs": [
        "keogh2010sled"
      ]
    },
    {
      "id": "short",
      "name": "Tiny shuffling steps",
      "looks": "Feet barely leave the ground and land in front of the hips.",
      "fix": "Drive each leg back until it is straight.",
      "why": "Slower sleds have shorter strides and longer contact times.",
      "pose": {
        "hipFlex": 20,
        "kneeFlex": 20
      },
      "detect": {
        "metric": "strideLength",
        "bad": "< 0.5 m"
      },
      "refs": [
        "keogh2010sled"
      ]
    }
  ],
  "safety": [
    "Check the floor and the path are clear.",
    "Heavy sleds: stop when form breaks rather than grinding."
  ],
  "variants": [
    {
      "when": "push",
      "change": "Hands on the poles, forward lean; high poles are easier, low poles harder."
    },
    {
      "when": "rear drag|backward",
      "change": "Facing the sled, straps in hands, walk backward: knees stay bent, mostly quads."
    },
    {
      "when": "drag",
      "change": "Harness or straps behind, walk or run forward: more hip extensors and hamstrings."
    },
    {
      "when": "pull$|power sled pull",
      "change": "Stand still and pull the sled toward you hand over hand on a rope: upper back, lats and grip."
    },
    {
      "when": "burpee",
      "change": "Burpee between pushes for conditioning."
    }
  ],
  "easier": [
    "lighter sled push",
    "walk"
  ],
  "harder": [
    "heavy sled push",
    "sprint sled drag",
    "strongman-event (truck pull)"
  ],
