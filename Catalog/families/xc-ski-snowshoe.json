{
  "id": "xc-ski-snowshoe",
  "name": "Cross-country skiing and snowshoeing",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "crossCountrySkiing",
  "pattern": "Whole-body travel over snow: legs kick or push, poles add an arm push, and you glide or step between pushes.",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "lats",
      "triceps",
      "heart-lungs"
    ],
    "secondary": [
      "abs",
      "hip-flexors",
      "calves",
      "glute-med",
      "adductors",
      "front-delts"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Classic skis need grip wax or skins for kick; skate skis are shorter and stiffer.",
    "Pole length: classic about to the armpit, skate about to the chin or mouth.",
    "Dress in layers you can open; you warm up fast.",
    "Snowshoes: bindings snug, crampons under the ball of the foot; poles help on hills."
  ],
  "steps": [
    {
      "phase": "Right leg kicks, right pole plants",
      "text": "Press the right ski down hard and kick back while the left ski glides forward."
    },
    {
      "phase": "Glide on left",
      "text": "Ride the left ski with your weight fully over it, knee soft, trunk leaning forward."
    },
    {
      "phase": "Left leg kicks, left pole plants",
      "text": "Swap: kick on the left, plant the left pole by the right foot."
    },
    {
      "phase": "Glide on right",
      "text": "Ride the right ski, arms swinging opposite to the legs."
    }
  ],
  "cues": [
    {
      "joint": "weight",
      "cue": "Commit your weight fully onto the gliding ski.",
      "why": "A full weight shift sets the grip zone for the next kick; half-weighting slips and wastes energy.",
      "refs": [
        "pellegrini2022"
      ]
    },
    {
      "joint": "kick",
      "cue": "Kick down and back from a bent knee, like a scooter push.",
      "why": "A fast, short push from a flexed knee is how skilled skiers make propulsion uphill.",
      "refs": [
        "pellegrini2022"
      ]
    },
    {
      "joint": "double pole",
      "cue": "Double pole: fall onto the poles with your body weight, then push past the hips.",
      "why": "Elite double poling uses trunk and hip flexion to load the poles, not just the arms.",
      "refs": [
        "holmberg2005",
        "stoggl2016"
      ]
    },
    {
      "joint": "poles",
      "cue": "Plant the pole angled back, by the opposite foot.",
      "why": "A pole planted ahead and vertical pushes you up, not forward.",
      "refs": [
        "holmberg2005"
      ]
    },
    {
      "joint": "snowshoe",
      "cue": "Snowshoes: slightly wider steps, lift the knee, land flat.",
      "why": "Walking on snow costs more energy, more so in deep or unpacked snow, so a steady pace matters.",
      "refs": [
        "connolly2002"
      ]
    }
  ],
  "breathing": "Breathe in rhythm with the stride; on double poling breathe out as you crunch onto the poles.",
  "tempo": {
    "note": "Diagonal stride about 45-60 cycles per minute; double poling 50-70 per minute; snowshoeing like brisk walking."
  },
  "mistakes": [
    {
      "id": "sitting-back",
      "name": "Sitting back",
      "looks": "Hips behind the feet, upright trunk, legs push forward instead of down.",
      "fix": "Shins and trunk lean forward, hips over the front foot.",
      "why": "Weight stays between the skis, so there is no grip and no glide.",
      "pose": {
        "trunk": -15,
        "kneeFlex": 15,
        "kneeFlexL": 15
      },
      "detect": {
        "metric": "hipOverFoot",
        "bad": "hips behind heel"
      },
      "refs": [
        "pellegrini2022"
      ]
    },
    {
      "id": "arms-only-dp",
      "name": "Double poling with arms only",
      "looks": "The trunk stays upright and only the elbows bend and straighten.",
      "fix": "Lead with the chest, crunch down onto the poles, then push.",
      "why": "Body weight on the poles is the main power source; arms alone tire fast.",
      "pose": {
        "trunk": -40,
        "hipFlex": -50,
        "hipFlexL": -50
      },
      "detect": {
        "metric": "trunkDP",
        "bad": "< 30 max lean"
      },
      "refs": [
        "holmberg2005",
        "stoggl2016"
      ]
    },
    {
      "id": "narrow-snowshoe",
      "name": "Snowshoes too narrow",
      "looks": "Feet step in a line and the shoe frames clip each other.",
      "fix": "Walk a little wider than normal and lift the knees.",
      "why": "Clipping frames trips you; falls cause many winter injuries.",
      "pose": {
        "hipAbd": -8,
        "hipAbdL": -8
      },
      "detect": {
        "metric": "stepWidth",
        "bad": "< frame width"
      },
      "refs": [
        "connolly2002",
        "smith1996"
      ]
    }
  ],
  "safety": [
    "Falls are the main injury cause: learn to snowplough and to fall to the side on hills.",
    "Thumb injuries: wear pole straps correctly and let go of the pole when you fall.",
    "Cold: cover hands, face and ears; leave plenty of daylight.",
    "Avalanche terrain: snowshoe only on known safe routes."
  ],
