{
  "id": "stationary-bike",
  "name": "Cycling",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "cycling",
  "sessionMetrics": [
    "power",
    "cadence",
    "resistance"
  ],
  "pattern": "Seated pedalling: legs push the pedals round in a circle while the trunk stays still. Covers indoor bikes and riding outdoors.",
  "muscles": {
    "primary": [
      "heart-lungs",
      "quads",
      "glutes"
    ],
    "secondary": [
      "hamstrings",
      "calves",
      "hip-flexors",
      "shins"
    ]
  },
  "equipment": [
    "stationary-bike"
  ],
  "setup": [
    "Saddle height: at the bottom of the stroke the knee is bent about 25-30°.",
    "Saddle level, at about hip height when you stand beside the bike.",
    "Balls of the feet over the pedal axles, straps or clips snug."
  ],
  "steps": [
    {
      "phase": "Top",
      "text": "Knee at its highest; start pushing forward over the top."
    },
    {
      "phase": "Push",
      "text": "Press down through the ball of the foot from 1 to 5 o'clock."
    },
    {
      "phase": "Bottom",
      "text": "Knee slightly bent, never locked; sweep the foot back."
    },
    {
      "phase": "Pull",
      "text": "Lift the knee back up toward the bar, the other leg pushing."
    }
  ],
  "cues": [
    {
      "joint": "knee",
      "cue": "Saddle high enough for a 25-30° knee bend at the bottom.",
      "why": "A low saddle raises kneecap compression; too high makes the hips rock.",
      "refs": [
        "bini2011"
      ]
    },
    {
      "joint": "knees",
      "cue": "Knees point straight ahead over the feet.",
      "why": "Knees caving in or out move load to the sides of the knee.",
      "refs": [
        "bini2011"
      ]
    },
    {
      "joint": "trunk",
      "cue": "Still hips, relaxed shoulders, soft elbows.",
      "why": "Rocking on the saddle means the saddle is too high or the resistance too low.",
      "refs": [
        "bini2011",
        "damiano2011"
      ]
    },
    {
      "joint": "cadence",
      "cue": "Steady 80-100 rpm; add resistance rather than grinding slow.",
      "why": "Moderate cadence with resistance spreads the work and is easier on the knees.",
      "refs": [
        "acsm-guidelines"
      ]
    }
  ],
  "breathing": "Steady breathing; on hard climbs breathe deeper, not faster.",
  "tempo": {
    "note": "Cadence 80-100 rpm for most rides; 60-80 for heavy climbs."
  },
  "mistakes": [
    {
      "id": "low-saddle",
      "name": "Saddle too low",
      "looks": "The knee stays very bent at the bottom and comes up high.",
      "fix": "Raise the saddle until the knee bends 25-30° at the bottom.",
      "why": "It raises patellofemoral load and front-of-knee pain.",
      "pose": {
        "kneeFlex": 15,
        "kneeFlexL": 15,
        "hipFlex": 10,
        "hipFlexL": 10
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "> 40 at bottom"
      },
      "refs": [
        "bini2011"
      ]
    },
    {
      "id": "high-saddle",
      "name": "Saddle too high",
      "looks": "Leg locks straight and the hips rock side to side.",
      "fix": "Lower the saddle until the knee stays soft at the bottom.",
      "why": "It overstretches the back of the knee and chafes the saddle.",
      "pose": {
        "kneeFlex": -15,
        "ankleDorsi": -15
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 20 at bottom"
      },
      "refs": [
        "bini2011"
      ]
    },
    {
      "id": "knee-in",
      "name": "Knees cave in",
      "looks": "Knees drift toward the top tube on the push.",
      "fix": "Push straight down, knee over the second toe.",
      "why": "Side load on the knee.",
      "pose": {
        "hipAbd": -8,
        "hipRot": -10
      },
      "detect": {
        "metric": "kneeTrack",
        "bad": "> 5 inward"
      },
      "refs": [
        "bini2011"
      ]
    }
  ],
  "safety": [
    "Knee pain at the front: check saddle height first.",
    "Back pain: raise the handlebars.",
    "Outdoors: wear a helmet and use lights in low light."
  ],
