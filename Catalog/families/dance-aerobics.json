{
  "id": "dance-aerobics",
  "name": "Dance and aerobics classes",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "cardioDance",
  "pattern": "Rhythmic stepping, bouncing and turning to music, with the arms adding work; impact ranges from low (one foot always down) to high (hops and jumps).",
  "muscles": {
    "primary": [
      "quads",
      "glutes",
      "calves",
      "heart-lungs"
    ],
    "secondary": [
      "hamstrings",
      "glute-med",
      "adductors",
      "abs",
      "obliques",
      "front-delts",
      "side-delts"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Supportive trainers with some cushion and a smooth sole for turning; a sprung or wooden floor is best.",
    "Step aerobics: set the platform low (10-15 cm) to start; it must not slide.",
    "Space to move an arm's length in every direction.",
    "Water nearby; the class warms up for the first 5-10 minutes."
  ],
  "steps": [
    {
      "phase": "Step right, hips sway",
      "text": "Step to the beat with soft knees; let the hips move with the step."
    },
    {
      "phase": "Bounce down, arms up",
      "text": "Bend both knees a little in rhythm; arms go up or out with the move."
    },
    {
      "phase": "Step left, hips sway",
      "text": "Same on the other side; the weight moves fully onto the stepping foot."
    },
    {
      "phase": "Bounce down, arms pump",
      "text": "Keep the chest lifted; add arms only when the feet are steady."
    }
  ],
  "cues": [
    {
      "joint": "knees",
      "cue": "Knees soft and over your toes on every step and landing.",
      "why": "Knees caving inward on landing predicted ACL injury in a prospective study of athletes.",
      "refs": [
        "hewett2005"
      ]
    },
    {
      "joint": "impact",
      "cue": "Choose low impact (one foot down) if you are new, heavy or have sore joints.",
      "why": "High-impact moves give clearly higher ground forces and joint loads than low-impact versions.",
      "refs": [
        "michaud1993",
        "wu2012"
      ]
    },
    {
      "joint": "step height",
      "cue": "Step: start with a low platform; your knee should not bend past about 90° on top.",
      "why": "Ground reaction force rises with step height and faster music.",
      "refs": [
        "maybury1997",
        "scharffolson1997"
      ]
    },
    {
      "joint": "feet",
      "cue": "Step: whole foot on the platform, step down close to it, toe-ball-heel.",
      "why": "Heels hanging off or stepping down far behind adds ankle and Achilles strain.",
      "refs": [
        "scharffolson1997"
      ]
    },
    {
      "joint": "effort",
      "cue": "Work at a level where you can still sing a line.",
      "why": "A Zumba class runs at about 79% of max heart rate on average, already vigorous for most people.",
      "refs": [
        "luettgen2012"
      ]
    }
  ],
  "breathing": "Breathe freely to the rhythm; never hold your breath on jumps.",
  "tempo": {
    "note": "Classes run at about 120-160 beats per minute; step aerobics usually 118-128 bpm. One loop = one 4-count move."
  },
  "mistakes": [
    {
      "id": "knee-cave",
      "name": "Knees cave in",
      "looks": "On landings, lunges and squats the knee drops inside the foot.",
      "fix": "Push the knees out over the second toe; land softly.",
      "why": "Inward knee collapse raises load on the knee ligaments.",
      "pose": {
        "hipAbd": -10,
        "hipRot": -15,
        "hipAbdL": -10,
        "hipRotL": -15
      },
      "detect": {
        "metric": "kneeValgus",
        "bad": "> 10"
      },
      "refs": [
        "hewett2005"
      ]
    },
    {
      "id": "stiff-landing",
      "name": "Stiff landings",
      "looks": "Hops land flat on straight legs with a loud slap.",
      "fix": "Land ball of foot to heel with bent knees, quietly.",
      "why": "Stiff landings pass more force up to the knees, hips and back.",
      "pose": {
        "kneeFlex": -25,
        "kneeFlexL": -25,
        "ankleDorsi": -15,
        "ankleDorsiL": -15
      },
      "detect": {
        "metric": "landingKnee",
        "bad": "< 20"
      },
      "refs": [
        "michaud1993",
        "wu2012"
      ]
    },
    {
      "id": "step-off-edge",
      "name": "Heel off the step",
      "looks": "Only the front of the foot is on the platform, or you step down far behind it.",
      "fix": "Whole foot on top; step down close to the platform.",
      "why": "It strains the Achilles and calf and risks a fall.",
      "pose": {
        "ankleDorsi": -20
      },
      "detect": {
        "metric": "footOnStep",
        "bad": "< 80% foot"
      },
      "refs": [
        "scharffolson1997"
      ]
    },
    {
      "id": "too-high",
      "name": "Platform too high",
      "looks": "The knee bends past 90° and you lean forward to get up.",
      "fix": "Lower the platform or skip the risers.",
      "why": "Higher steps and faster tempo raise impact forces.",
      "pose": {
        "hipFlex": 20,
        "kneeFlex": 30,
        "trunk": 10
      },
      "detect": {
        "metric": "stepKnee",
        "bad": "> 90"
      },
      "refs": [
        "maybury1997"
      ]
    }
  ],
  "safety": [
    "Twisting on a planted foot is the classic knee injury in dance; turn on the ball of the foot with the knee soft.",
    "Shin or foot pain: switch to low impact and check your shoes and floor.",
    "Feel dizzy after spins: spot a point with your eyes and slow down."
  ],
