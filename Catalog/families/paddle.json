{
  "id": "paddle",
  "name": "Paddling and rowing on water",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "distance_time_hr",
  "healthKit": "paddleSports",
  "pattern": "A pull through the water driven by the legs and trunk; the arms mostly connect the body to the blade.",
  "muscles": {
    "primary": [
      "lats",
      "obliques",
      "heart-lungs"
    ],
    "secondary": [
      "quads",
      "glutes",
      "rear-delts",
      "mid-traps",
      "biceps",
      "abs",
      "lower-back",
      "wrist-flexors"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Wear a buoyancy aid (PFD) and check wind, current and water temperature.",
    "Kayak and canoe: sit tall, feet braced; grip the shaft a little wider than your shoulders.",
    "SUP: feet hip width either side of the handle, knees soft, eyes on the horizon.",
    "Rowing: feet strapped, handle in the fingers, start with arms only, then add body and legs."
  ],
  "steps": [
    {
      "phase": "Catch",
      "text": "Reach forward from the hips with long arms and put the blade fully in."
    },
    {
      "phase": "Leg drive",
      "text": "Push with the legs first (or the foot brace in a kayak)."
    },
    {
      "phase": "Body swings back",
      "text": "Open the trunk (rowing) or rotate it (kayak, SUP) while the arms stay long."
    },
    {
      "phase": "Finish",
      "text": "Arms finish the stroke near the ribs or hip; take the blade out cleanly."
    },
    {
      "phase": "Recovery: hands, body, slide",
      "text": "Arms away, body forward, then slide or reach for the next catch."
    }
  ],
  "cues": [
    {
      "joint": "sequence",
      "cue": "Legs, then body, then arms; reverse on the way back.",
      "why": "The legs give most rowing power; arms-first pulling wastes it and tires the arms.",
      "refs": [
        "soper2004"
      ]
    },
    {
      "joint": "back",
      "cue": "Hinge from the hips with a long spine at the catch.",
      "why": "The lower back is the most injured area in rowing; deep slumped flexion at the catch adds strain.",
      "refs": [
        "mcgregor2002",
        "thornton2017"
      ]
    },
    {
      "joint": "trunk",
      "cue": "Kayak and SUP: rotate the trunk; the bottom arm stays fairly straight.",
      "why": "Trunk, pelvis and leg motion drive kayak power; arm-only strokes overload the shoulder.",
      "refs": [
        "bjerkefors2018"
      ]
    },
    {
      "joint": "top hand",
      "cue": "Keep the top hand at or below eye level and in front of you.",
      "why": "A high, wide top hand puts the shoulder at the end range where dislocations happen in kayaking.",
      "refs": [
        "fiore2001"
      ]
    },
    {
      "joint": "blade",
      "cue": "Plant the whole blade, pull it to your hip or feet, then lift it out.",
      "why": "Strokes past the hip lift water and twist the trunk with little speed.",
      "refs": [
        "schram2016"
      ]
    },
    {
      "joint": "grip",
      "cue": "Loose grip; push the top hand, pull the bottom.",
      "why": "A tight grip tires the forearms and wrists, a common overuse site.",
      "refs": [
        "fiore2001"
      ]
    }
  ],
  "breathing": "Breathe out on the pull, in on the recovery; at higher rates breathe twice per stroke.",
  "tempo": {
    "note": "Rowing: drive about 1 part, recovery 2 parts; 18-24 strokes per minute steady. Kayak about 50-70 strokes per minute (both sides). SUP 30-40 per minute."
  },
  "mistakes": [
    {
      "id": "arms-only",
      "name": "Pulling with the arms",
      "looks": "The elbows bend as soon as the blade goes in; legs and trunk stay still.",
      "fix": "Keep the arms long until the legs (rowing) or trunk rotation (kayak) has done its part.",
      "why": "Small arm muscles do the work of big ones; power drops and elbows and shoulders tire.",
      "pose": {
        "elbowFlex": 60,
        "trunk": 10
      },
      "detect": {
        "metric": "earlyArmBend",
        "bad": "> 20 in first third of drive"
      },
      "refs": [
        "soper2004",
        "bjerkefors2018"
      ]
    },
    {
      "id": "slumped-catch",
      "name": "Slumped catch",
      "looks": "The back rounds and the head drops as you reach forward.",
      "fix": "Sit tall on the sit bones and hinge from the hips; reach only as far as your back stays long.",
      "why": "Large lumbar flexion under load goes with low back pain in rowers.",
      "pose": {
        "lumbar": 20,
        "neck": 20
      },
      "detect": {
        "metric": "lumbar",
        "bad": "> 30"
      },
      "refs": [
        "mcgregor2002",
        "thornton2017"
      ]
    },
    {
      "id": "high-top-hand",
      "name": "Top hand too high",
      "looks": "The top hand goes above the head or far behind it (bracing or steep strokes).",
      "fix": "Top hand at eye height; on support strokes keep elbows low and close.",
      "why": "Overhead, rotated arm positions are where kayak shoulder dislocations occur.",
      "pose": {
        "shoulderFlexL": 50,
        "shoulderAbdL": 30
      },
      "detect": {
        "metric": "topHand",
        "bad": "above head"
      },
      "refs": [
        "fiore2001"
      ]
    },
    {
      "id": "straight-legs-sup",
      "name": "SUP: bent at the waist, legs straight",
      "looks": "Knees locked and the back bends to reach the water.",
      "fix": "Soft knees, hinge at the hips, let the legs help lower the blade.",
      "why": "It loads the lower back and makes balance harder.",
      "pose": {
        "kneeFlex": -15,
        "kneeFlexL": -15,
        "lumbar": 20
      },
      "detect": {
        "metric": "kneeFlex",
        "bad": "< 5"
      },
      "refs": [
        "schram2016"
      ]
    }
  ],
  "safety": [
    "Always wear a buoyancy aid; dress for the water temperature, not the air.",
    "Learn a capsize or wet exit in calm water with help before going out alone.",
    "Rowing rib pain that is sharp with deep breaths: stop and get checked (rib stress fracture).",
    "Low back pain: shorten sessions, lower the stroke rate and check your catch."
  ],
