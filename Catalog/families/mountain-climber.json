{
  "id": "mountain-climber",
  "name": "Mountain climber",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "highIntensityIntervalTraining",
  "sessionMetrics": [
    "reps"
  ],
  "pattern": "Running in a high plank: knees drive alternately toward the chest while the hands and trunk stay still.",
  "muscles": {
    "primary": [
      "heart-lungs",
      "abs",
      "hip-flexors"
    ],
    "secondary": [
      "front-delts",
      "chest",
      "triceps",
      "serratus-anterior",
      "obliques",
      "quads",
      "glutes"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "High plank: hands under the shoulders, arms straight.",
    "Body in one line from head to heels, on your toes.",
    "Brace your abs as if for a punch."
  ],
  "steps": [
    {
      "phase": "Right in",
      "text": "Drive the right knee toward your chest, toes touching down under the hip."
    },
    {
      "phase": "Switch",
      "text": "Swap legs in one quick move: right back, left in."
    },
    {
      "phase": "Left in",
      "text": "Left knee in, right leg long behind you. Hips stay low."
    }
  ],
  "cues": [
    {
      "joint": "hips",
      "cue": "Hips at plank height, not up in the air.",
      "why": "The trunk muscles must hold the spine still while the legs move; high hips take that work away.",
      "refs": [
        "mcgill-low-back"
      ]
    },
    {
      "joint": "shoulders",
      "cue": "Shoulders stacked over the wrists, push the floor away.",
      "why": "Shoulders behind the hands load the wrists and lose the plank.",
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "joint": "knees",
      "cue": "Full knee drive: toes land under the hip.",
      "why": "Short drives cut the range and the work.",
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "joint": "pace",
      "cue": "Fast only as long as the plank holds.",
      "why": "At speed in HIIT this reaches about 11 MET; form breaks first in the hips.",
      "refs": [
        "herrmann2024"
      ]
    }
  ],
  "breathing": "Quick, steady breaths; out with every second drive.",
  "tempo": {
    "note": "About 2 knee drives a second at a fast pace, one a second for control."
  },
  "mistakes": [
    {
      "id": "pike",
      "name": "Hips bounce high",
      "looks": "Hips rise above the shoulders with each drive.",
      "fix": "Slow down; keep the hips level with the shoulders.",
      "why": "The core stops working and the move turns into a jog in a pike.",
      "pose": {
        "hipFlex": 25,
        "hipFlexL": 25,
        "trunk": -15
      },
      "detect": {
        "metric": "hipLine",
        "bad": "> 15"
      },
      "refs": [
        "mcgill-low-back"
      ]
    },
    {
      "id": "shoulders-back",
      "name": "Shoulders behind the hands",
      "looks": "Weight shifts to the feet, shoulders drift back.",
      "fix": "Lean forward until the shoulders are over the wrists.",
      "why": "Wrists bend too far and the shoulders lose support.",
      "pose": {
        "shoulderFlex": 20,
        "wristExt": -15
      },
      "detect": {
        "metric": "shoulderOverWrist",
        "bad": "> 10 cm behind"
      },
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "id": "sag",
      "name": "Lower back sags",
      "looks": "The belly drops toward the floor.",
      "fix": "Brace and squeeze the glutes.",
      "why": "The lower back arches under load.",
      "pose": {
        "lumbar": -15,
        "hipFlexL": -10
      },
      "detect": {
        "metric": "hipLine",
        "bad": "< -8"
      },
      "refs": [
        "mcgill-low-back"
      ]
    }
  ],
  "safety": [
    "Wrist pain: hands on a bench or on fists.",
    "Lower-back pain: slow, controlled drives with hands raised."
  ],
  "variants": [
    {
      "when": "general|fast|hiit",
      "change": "Fast in HIIT: about 11.0 MET (02214).",
      "met": 11.0,
      "metCode": "02214"
    },
    {
      "when": "slow|moderate",
      "change": "Steady, moderate HIIT: about 7.0 MET (02210).",
      "met": 7.0,
      "metCode": "02210"
    },
    {
      "when": "cross|spider|side|twist",
      "change": "Knee drives across to the opposite elbow (cross) or outside to the same elbow (spider): more obliques."
    },
    {
      "when": "suspension|slide|towel",
      "change": "Feet in straps or on a slider: no foot contact on the drive, more core work."
    }
  ],
