{
  "id": "woodchop-rotation",
  "name": "Woodchop and rotation",
  "kind": "core",
  "bodyModel": "anatomy",
  "tracking": "reps",
  "pattern": "Trunk rotation: the arms carry a load across the body on a diagonal (chop, lift) or side to side (Russian twist, wipers) while the hips and trunk turn.",
  "muscles": {
    "primary": [
      "obliques"
    ],
    "secondary": [
      "abs",
      "deep-core",
      "glutes",
      "front-delts",
      "lats",
      "hip-flexors"
    ]
  },
  "equipment": [
    "cable-stack",
    "band",
    "medicine-ball",
    "dumbbell",
    "kettlebell",
    "plate",
    "landmine",
    "machine",
    "barbell"
  ],
  "setup": [
    "Stand side-on to a high cable, feet a bit wider than hips, knees soft.",
    "Grab the handle with both hands above your near shoulder, arms long.",
    "Brace and stand tall."
  ],
  "steps": [
    {
      "phase": "Chop",
      "text": "Pull the handle down and across to the opposite hip, turning your hips and shoulders together."
    },
    {
      "phase": "Finish",
      "text": "Finish with arms long by the far knee, back foot pivoting."
    },
    {
      "phase": "Return",
      "text": "Let the handle travel back up the same line under control."
    }
  ],
  "cues": [
    {
      "joint": "hips",
      "cue": "Turn from the hips; pivot the back foot.",
      "why": "Sharing the turn with the hips keeps twisting load off the lumbar spine.",
      "refs": [
        "mcgill2009bb",
        "marshall2010"
      ]
    },
    {
      "joint": "spine",
      "cue": "Tall spine: don't round forward as you twist.",
      "why": "Twisting combined with bending forward raises the risk of disc injury.",
      "refs": [
        "marshall2010"
      ]
    },
    {
      "joint": "arms",
      "cue": "Arms long, hands follow your chest.",
      "why": "The trunk muscles make the turn; the arms just transmit it.",
      "refs": [
        "mcgill1991"
      ]
    },
    {
      "joint": "speed",
      "cue": "Control the return as much as the chop.",
      "why": "Power and strength tests on the cable chop need steady technique to be repeatable.",
      "refs": [
        "zemkova2017",
        "rodriguezperea2023"
      ]
    }
  ],
  "breathing": "Breathe out as you chop or twist, in as you return.",
  "tempo": {
    "down": 2,
    "pause": 0,
    "up": 1,
    "note": "Chop in about 1 s, return in 2. Power versions move fast but stay controlled."
  },
  "mistakes": [
    {
      "id": "round",
      "name": "Rounding while twisting",
      "looks": "The back rounds forward as the arms come across.",
      "fix": "Hinge at the hips and keep your chest up.",
      "why": "Flexion plus twist is the riskiest spine load.",
      "pose": {
        "lumbar": 25,
        "trunk": 25
      },
      "detect": {
        "metric": "lumbar",
        "bad": "> 15"
      },
      "refs": [
        "marshall2010"
      ]
    },
    {
      "id": "arms-only",
      "name": "Arms only",
      "looks": "The hips and shoulders stay square while the arms swing across.",
      "fix": "Turn your belt buckle with the handle.",
      "why": "The trunk muscles are skipped and the shoulders take the load.",
      "pose": {
        "hipRot": 0,
        "shoulderAbd": 40
      },
      "detect": {
        "metric": "hipTurn",
        "bad": "< 15"
      },
      "refs": [
        "mcgill2009bb"
      ]
    },
    {
      "id": "locked-feet",
      "name": "Feet stuck",
      "looks": "Both feet stay planted and the knees twist.",
      "fix": "Pivot on the back foot as you turn.",
      "why": "Rotation then twists the knees and low back.",
      "pose": {
        "kneeFlex": 30
      },
      "detect": {
        "metric": "backFootPivot",
        "bad": "< 20"
      },
      "refs": [
        "mcgill2009bb"
      ]
    }
  ],
  "safety": [
    "Disc problems or low back pain: avoid fast loaded twisting with a rounded back; use anti-rotation (Pallof) work first.",
    "Russian twists: keep the chest up; turning the shoulders while rounded loads the discs."
  ],
  "variants": [
    {
      "when": "reverse|low|lift|up|thor|slingshot",
      "change": "Low-to-high lift: the same path in reverse."
    },
    {
      "when": "kneeling|half kneeling",
      "change": "Kneeling: the hips cannot help, so the trunk does more."
    },
    {
      "when": "russian|seated twist|sitting",
      "change": "Seated, leaning back about 45 degrees, rotating the load side to side."
    },
    {
      "when": "wiper|windshield|lying twist|leg twist",
      "change": "Lying on your back, legs swing side to side."
    },
    {
      "when": "landmine|180",
      "change": "Bar end in a landmine: arms trace an arc from hip to hip."
    },
    {
      "when": "lever|machine|torso rotation",
      "change": "Seated rotation machine: hips fixed, trunk rotates against the pad."
    },
    {
      "when": "squat|lunge",
      "change": "Chop combined with a squat or lunge."
    }
  ],
  "easier": [
    "pallof-anti-rotation",
