{
  "id": "climbing",
  "name": "Rock climbing and bouldering",
  "kind": "sport",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "climbing",
  "pattern": "Moving up a wall on hand and foot holds: the legs push you up, the arms mostly hold you close.",
  "muscles": {
    "primary": [
      "wrist-flexors",
      "lats",
      "biceps",
      "quads",
      "heart-lungs"
    ],
    "secondary": [
      "brachialis",
      "brachioradialis",
      "rotator-cuff",
      "lower-traps",
      "abs",
      "calves",
      "glutes"
    ]
  },
  "equipment": [
    "none"
  ],
  "setup": [
    "Snug climbing shoes; chalk for dry hands.",
    "Roped climbing: harness buckled, figure-eight knot tied and both partners check each other.",
    "Bouldering: check the mats cover your landing zone; nobody under you.",
    "Warm up on easy routes and open-hand holds for 10-15 minutes."
  ],
  "steps": [
    {
      "phase": "Rest on straight arms",
      "text": "Hang from your skeleton: arms long, hips close to the wall, weight on your feet."
    },
    {
      "phase": "Step the right foot up",
      "text": "Look at the next foothold and place your toe on it precisely."
    },
    {
      "phase": "Stand up on the leg, reach left",
      "text": "Push up with the leg and reach with the opposite hand."
    },
    {
      "phase": "Hips in, bring the left foot up",
      "text": "Hold the new hold, bring your hips back to the wall, then move your feet."
    }
  ],
  "cues": [
    {
      "joint": "legs",
      "cue": "Push with your legs; pull only to stay on.",
      "why": "Forearm and finger endurance limit climbing; using the legs spares them.",
      "refs": [
        "watts2004",
        "giles2006"
      ]
    },
    {
      "joint": "hips",
      "cue": "Keep your hips close to the wall.",
      "why": "A centre of mass near the wall puts more weight on the feet and less on the hands.",
      "refs": [
        "zampagni2011",
        "quaine1999"
      ]
    },
    {
      "joint": "arms",
      "cue": "Straight arms when resting; bend them only to move.",
      "why": "Holding a bent arm keeps the biceps and forearms working and they pump out sooner.",
      "refs": [
        "watts2004"
      ]
    },
    {
      "joint": "fingers",
      "cue": "Use open-hand grips when you can; save full crimps.",
      "why": "The full crimp loads the finger pulleys most; pulley tears are the most common climbing injury.",
      "refs": [
        "schoffl2009",
        "jones2008"
      ]
    },
    {
      "joint": "feet",
      "cue": "Quiet feet: look at the hold and place the toe once.",
      "why": "Precise footwork keeps weight on the legs and holds balance when you release a limb.",
      "refs": [
        "quaine1999"
      ]
    },
    {
      "joint": "falls",
      "cue": "Bouldering: down-climb when you can; land on both feet, knees bent, then roll back.",
      "why": "Lower-leg injuries in bouldering are fewer but more serious, and most come from falls and jumping off.",
      "refs": [
        "auer2021"
      ]
    }
  ],
  "breathing": "Breathe out as you make a hard move; on rests, slow deep breaths and shake out each arm.",
  "tempo": {
    "note": "One loop = one move: step, push, reach, settle. Climb steadily; rest on good holds."
  },
  "mistakes": [
    {
      "id": "bent-arms",
      "name": "Climbing on bent arms",
      "looks": "Elbows stay bent and the body hangs close by pulling.",
      "fix": "Let the arms go long and sink the hips; push with the legs.",
      "why": "The forearms and biceps pump out fast, and grip fails.",
      "pose": {
        "elbowFlex": 60,
        "elbowFlexL": 60
      },
      "detect": {
        "metric": "restElbow",
        "bad": "> 40"
      },
      "refs": [
        "watts2004"
      ]
    },
    {
      "id": "hips-out",
      "name": "Hips away from the wall",
      "looks": "Bottom sticks out, body like an A-frame.",
      "fix": "Turn a hip in or push the hips toward the wall.",
      "why": "Weight shifts from the feet onto the hands.",
      "pose": {
        "hipFlex": 30,
        "hipFlexL": 30,
        "trunk": -10
      },
      "detect": {
        "metric": "hipToWall",
        "bad": "> 35 cm"
      },
      "refs": [
        "zampagni2011",
        "quaine1999"
      ]
    },
    {
      "id": "stiff-landing",
      "name": "Stiff-legged landing",
      "looks": "Dropping off a boulder with straight legs or onto one foot or hands.",
      "fix": "Land on both feet, bend the knees, roll onto your back.",
      "why": "Falls and jumping off cause most serious bouldering leg injuries.",
      "pose": {
        "kneeFlex": -60,
        "kneeFlexL": -60,
        "hipFlex": -50,
        "hipFlexL": -50
      },
      "detect": {
        "metric": "landingKnee",
        "bad": "< 30"
      },
      "refs": [
        "auer2021"
      ]
    }
  ],
  "safety": [
    "A pop in a finger with pain at its base: stop climbing that day and get it checked (pulley injury).",
    "Roped climbing: always do partner checks of knot, harness and belay device.",
    "Build finger load slowly; new climbers should not hangboard in the first year.",
    "Shoulder pain on big reaches: shorten moves and train shoulder blade control."
  ],
