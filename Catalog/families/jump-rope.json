{
  "id": "jump-rope",
  "name": "Jump rope",
  "kind": "cardio",
  "bodyModel": "skin",
  "tracking": "time_hr",
  "healthKit": "jumpRope",
  "sessionMetrics": [
    "jumps"
  ],
  "pattern": "Small rhythmic hops on the balls of the feet while the wrists turn the rope under you.",
  "muscles": {
    "primary": [
      "heart-lungs",
      "calves",
      "soleus"
    ],
    "secondary": [
      "quads",
      "glutes",
      "shins",
      "foot",
      "front-delts",
      "wrist-flexors",
      "wrist-extensors",
      "abs"
    ]
  },
  "equipment": [
    "jump-rope"
  ],
  "setup": [
    "Rope length: stand on the middle, handles reach about your armpits.",
    "Elbows close to your sides, hands just in front of the hips.",
    "Feet together, weight on the balls of the feet."
  ],
  "steps": [
    {
      "phase": "Land",
      "text": "Land softly on the balls of your feet, knees a little bent."
    },
    {
      "phase": "Load",
      "text": "Heels stay just off the floor; ankles and knees give."
    },
    {
      "phase": "Push",
      "text": "Spring up with the ankles as the rope comes under your feet."
    },
    {
      "phase": "Flight",
      "text": "Hop only 2-3 cm high while the wrists keep turning."
    }
  ],
  "cues": [
    {
      "joint": "feet",
      "cue": "Balls of the feet, heels kissing the floor at most.",
      "why": "Rope jumping is driven by the ankles; landing on the forefoot lets the calves and tendons absorb and return energy.",
      "refs": [
        "rope2022",
        "rope2023"
      ]
    },
    {
      "joint": "height",
      "cue": "Just clear the rope: 2-3 cm.",
      "why": "Higher hops cost more effort and land harder for no benefit.",
      "refs": [
        "rope2022"
      ]
    },
    {
      "joint": "wrists",
      "cue": "Turn the rope with the wrists, elbows by your sides.",
      "why": "Big arm circles slow the rope and tire the shoulders.",
      "refs": [
        "nsca-estc"
      ]
    },
    {
      "joint": "knees",
      "cue": "Soft knees, never locked on landing.",
      "why": "Knee bend shares the landing load with the ankle.",
      "refs": [
        "rope2022"
      ]
    }
  ],
  "breathing": "Steady and relaxed; do not hold your breath.",
  "tempo": {
    "note": "About 100-140 turns a minute; one hop per turn."
  },
  "mistakes": [
    {
      "id": "too-high",
      "name": "Jumping too high",
      "looks": "Knees tuck up and you float well above the rope.",
      "fix": "Hop just high enough for the rope to pass.",
      "why": "Wastes energy and lands harder.",
      "pose": {
        "kneeFlex": 40,
        "kneeFlexL": 40,
        "hipFlex": 30,
        "hipFlexL": 30
      },
      "detect": {
        "metric": "jumpHeight",
        "bad": "> 8 cm"
      },
      "refs": [
        "rope2022"
      ]
    },
    {
      "id": "heels",
      "name": "Landing on the heels",
      "looks": "Flat-footed thuds, heels hit first.",
      "fix": "Stay on the balls of your feet.",
      "why": "Heel landings send the shock up to the knees and back.",
      "pose": {
        "ankleDorsi": 15,
        "ankleDorsiL": 15,
        "kneeFlex": -10,
        "kneeFlexL": -10
      },
      "detect": {
        "metric": "ankleDorsi",
        "bad": "> 10 at contact"
      },
      "refs": [
        "rope2023"
      ]
    },
    {
      "id": "big-arms",
      "name": "Arms swing wide",
      "looks": "Elbows lift away and the whole arm circles.",
      "fix": "Elbows in, small wrist circles.",
      "why": "The rope slows and the shoulders tire.",
      "pose": {
        "shoulderAbd": 40,
        "shoulderFlex": 30
      },
      "detect": {
        "metric": "shoulderAbd",
        "bad": "> 45"
      },
      "refs": [
        "nsca-estc"
      ]
    }
  ],
  "safety": [
    "Jump on wood, rubber or a mat, not concrete.",
    "Calf or shin pain: shorter sessions, build up slowly."
  ],
  "variants": [
    {
      "when": "slow|easy|<100",
      "change": "Slow, under 100 skips a minute: about 8.3 MET (15552).",
      "met": 8.3,
      "metCode": "15552"
    },
    {
      "when": "moderate|100-120",
      "change": "100-120 skips a minute: about 11.8 MET (15551).",
      "met": 11.8,
      "metCode": "15551"
    },
    {
      "when": "fast|120-160|sprint",
      "change": "120-160 skips a minute: about 12.3 MET (15550).",
